/* ========================================================================== *
 * SECTION 02 — Utils.gs
 * Utils, Cache, SheetDB and Settings — the foundation layer.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Utils.gs
 * ----------------------------------------------------------------------------
 * Cross cutting helpers:
 *   Utils    — ids, dates, sanitising, hashing, response envelopes
 *   Cache    — CacheService wrapper with chunking for >100KB payloads
 *   SheetDB  — batched spreadsheet access (read once, write in batches)
 *   Settings — key/value application settings
 * ============================================================================
 */

/* ------------------------------------------------------------------ *
 * Per-execution memo. Apps Script gives each execution a fresh global
 * scope, so this is a safe request-scoped cache.
 * ------------------------------------------------------------------ */
var __MEMO__ = {};

var Utils = (function () {

  // Control characters, excluding TAB (09), LF (0A) and CR (0D).
  var CONTROL_ALL  = new RegExp('[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]', 'g');
  // Same, but also allows TAB / LF / CR to survive (used for SQL bodies).
  var CONTROL_TEXT = new RegExp('[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]', 'g');

  /** RFC4122 unique id. */
  function uuid() {
    return Utilities.getUuid();
  }

  /** Random opaque token (used for session ids and salts). */
  function token(len) {
    var raw = Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, '');
    return raw.substring(0, len || 40);
  }

  function now() {
    return new Date();
  }

  /** ISO string used for every timestamp column. */
  function iso(d) {
    return (d instanceof Date ? d : new Date(d)).toISOString();
  }

  function tz() {
    return Session.getScriptTimeZone() || 'Etc/GMT';
  }

  /** Human readable: 02-Sep-2026 10:30 AM */
  function fmt(d) {
    if (!d) return '';
    var dd = (d instanceof Date) ? d : new Date(d);
    if (isNaN(dd.getTime())) return String(d);
    return Utilities.formatDate(dd, tz(), 'dd-MMM-yyyy hh:mm a');
  }

  function fmtDateOnly(d) {
    var dd = (d instanceof Date) ? d : new Date(d);
    if (isNaN(dd.getTime())) return String(d);
    return Utilities.formatDate(dd, tz(), 'yyyy-MM-dd');
  }

  function pad(n, width) {
    var s = String(n);
    while (s.length < width) s = '0' + s;
    return s;
  }

  function addMinutes(d, mins) {
    return new Date((d instanceof Date ? d : new Date(d)).getTime() + mins * 60000);
  }

  /* ---------------------------------------------------------------- *
   * Sanitising
   * ---------------------------------------------------------------- */

  /** Escape HTML for anything that could be interpolated into markup. */
  function escapeHtml(s) {
    if (s === null || s === undefined) return '';
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  /**
   * Neutralise spreadsheet formula injection.
   * A value beginning with = + - @ TAB or CR is prefixed with a single quote
   * so Sheets stores it as literal text and never evaluates it.
   */
  function safeCell(v) {
    if (v === null || v === undefined) return '';
    if (v instanceof Date) return v;
    if (typeof v === 'number' || typeof v === 'boolean') return v;
    var s = String(v);
    if (/^[=+\-@\t\r]/.test(s)) return "'" + s;
    return s;
  }

  /** Trim, strip control characters, hard length cap. Single line values. */
  function text(v, maxLen) {
    if (v === null || v === undefined) return '';
    var s = String(v).replace(CONTROL_ALL, '');
    s = s.replace(/^\s+|\s+$/g, '');
    if (maxLen && s.length > maxLen) s = s.substring(0, maxLen);
    return s;
  }

  /** SQL / multi-line body: keeps newlines and tabs, strips other controls. */
  function sqlText(v, maxLen) {
    if (v === null || v === undefined) return '';
    var s = String(v).replace(CONTROL_TEXT, '');
    s = s.replace(/\s+$/g, '');
    if (maxLen && s.length > maxLen) s = s.substring(0, maxLen);
    return s;
  }

  /** Normalise a comma separated tag list. */
  function tags(v) {
    var s = text(v, APP.MAX_TAGS);
    if (!s) return '';
    var parts = s.split(',');
    var out = [], seen = {};
    for (var i = 0; i < parts.length; i++) {
      var t = parts[i].replace(/^\s+|\s+$/g, '').replace(/[<>"']/g, '');
      if (!t) continue;
      var k = t.toLowerCase();
      if (seen[k]) continue;
      seen[k] = true;
      out.push(t);
      if (out.length >= 20) break;
    }
    return out.join(', ');
  }

  function isEmail(v) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(v || '').replace(/^\s+|\s+$/g, ''));
  }

  function normEmail(v) {
    return String(v || '').replace(/^\s+|\s+$/g, '').toLowerCase();
  }

  function bool(v) {
    if (v === true) return true;
    if (v === false || v === null || v === undefined || v === '') return false;
    var s = String(v).toLowerCase();
    return s === 'true' || s === 'yes' || s === '1' || s === 'y';
  }

  function num(v, dflt) {
    var n = Number(v);
    return isNaN(n) ? (dflt === undefined ? 0 : dflt) : n;
  }

  function clampInt(v, min, max, dflt) {
    var n = parseInt(v, 10);
    if (isNaN(n)) return dflt;
    return Math.min(max, Math.max(min, n));
  }

  /* ---------------------------------------------------------------- *
   * Password hashing
   *
   * Be honest about this: Apps Script has no bcrypt/scrypt/argon2.
   * We use salted SHA-256 with key stretching, which is materially weaker
   * than a purpose built password hash. Google SSO is the recommended
   * primary authentication path; app passwords are a fallback.
   * See docs/SECURITY.md.
   * ---------------------------------------------------------------- */
  var HASH_ROUNDS = 12000;

  function newSalt() {
    return token(32);
  }

  function hashPassword(password, salt) {
    var data = salt + '|' + password + '|' + APP.NAME;
    var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, data, Utilities.Charset.UTF_8);
    for (var i = 0; i < HASH_ROUNDS; i++) {
      bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, bytes);
    }
    return Utilities.base64Encode(bytes);
  }

  /** Comparison that does not short circuit on the first differing byte. */
  function safeEquals(a, b) {
    a = String(a || ''); b = String(b || '');
    if (a.length !== b.length) return false;
    var diff = 0;
    for (var i = 0; i < a.length; i++) diff |= (a.charCodeAt(i) ^ b.charCodeAt(i));
    return diff === 0;
  }

  function validatePasswordStrength(pw) {
    var s = String(pw || '');
    if (s.length < 10) return 'Password must be at least 10 characters.';
    if (!/[A-Za-z]/.test(s)) return 'Password must contain a letter.';
    if (!/[0-9]/.test(s)) return 'Password must contain a number.';
    return null;
  }

  /* ---------------------------------------------------------------- *
   * Response envelopes — every server function returns this shape.
   * ---------------------------------------------------------------- */
  function ok(data, message) {
    return { success: true, data: (data === undefined ? null : data), message: message || '' };
  }

  function err(message, code) {
    return {
      success: false,
      data: null,
      message: message || 'Something went wrong. Please try again.',
      code: code || 'ERROR'
    };
  }

  /** Internal error logging — technical detail never reaches normal users. */
  function logError(e, where) {
    try {
      console.error('[' + APP.NAME + '] ' + (where || '') + ' :: ' + (e && e.stack ? e.stack : e));
    } catch (ignored) {}
  }

  function clone(o) {
    return o === null || o === undefined ? o : JSON.parse(JSON.stringify(o));
  }

  /** Sort an array of objects by key. dir = 'asc' | 'desc' (default desc). */
  function sortBy(arr, key, dir) {
    var m = (dir === 'asc') ? 1 : -1;
    return arr.sort(function (a, b) {
      var x = a[key], y = b[key];
      if (x === y) return 0;
      if (x === null || x === undefined || x === '') return 1;
      if (y === null || y === undefined || y === '') return -1;
      return (x > y ? 1 : -1) * m;
    });
  }

  function chunk(arr, size) {
    var out = [];
    for (var i = 0; i < arr.length; i += size) out.push(arr.slice(i, i + size));
    return out;
  }

  return {
    uuid: uuid, token: token, now: now, iso: iso, fmt: fmt, fmtDateOnly: fmtDateOnly,
    tz: tz, pad: pad, addMinutes: addMinutes,
    escapeHtml: escapeHtml, safeCell: safeCell, text: text, sqlText: sqlText, tags: tags,
    isEmail: isEmail, normEmail: normEmail, bool: bool, num: num, clampInt: clampInt,
    newSalt: newSalt, hashPassword: hashPassword, safeEquals: safeEquals,
    validatePasswordStrength: validatePasswordStrength,
    ok: ok, err: err, logError: logError, clone: clone, sortBy: sortBy, chunk: chunk
  };
})();


/* ==================================================================== *
 * Cache — CacheService wrapper that transparently chunks large payloads.
 * (CacheService caps a single value at 100 KB.)
 * ==================================================================== */
var Cache = (function () {
  var MAX = 90 * 1024;

  function c() { return CacheService.getScriptCache(); }

  function put(key, obj, ttl) {
    try {
      var json = JSON.stringify(obj);
      var parts = Math.max(1, Math.ceil(json.length / MAX));
      var map = {};
      map[key + '::parts'] = String(parts);
      for (var i = 0; i < parts; i++) {
        map[key + '::' + i] = json.substring(i * MAX, (i + 1) * MAX);
      }
      c().putAll(map, ttl);
    } catch (e) { Utils.logError(e, 'Cache.put ' + key); }
  }

  function get(key) {
    try {
      var partsRaw = c().get(key + '::parts');
      if (!partsRaw) return null;
      var parts = parseInt(partsRaw, 10);
      var keys = [];
      for (var i = 0; i < parts; i++) keys.push(key + '::' + i);
      var all = c().getAll(keys);
      var json = '';
      for (var j = 0; j < parts; j++) {
        var piece = all[key + '::' + j];
        if (piece === null || piece === undefined) return null;   // partial expiry -> miss
        json += piece;
      }
      return JSON.parse(json);
    } catch (e) {
      Utils.logError(e, 'Cache.get ' + key);
      return null;
    }
  }

  function remove(key) {
    try {
      var partsRaw = c().get(key + '::parts');
      var keys = [key + '::parts'];
      var parts = partsRaw ? parseInt(partsRaw, 10) : 8;
      for (var i = 0; i < parts; i++) keys.push(key + '::' + i);
      c().removeAll(keys);
    } catch (e) { Utils.logError(e, 'Cache.remove ' + key); }
  }

  return { put: put, get: get, remove: remove };
})();


/* ==================================================================== *
 * SheetDB — the only module that talks to SpreadsheetApp.
 *
 * Rules enforced here:
 *   - one getValues() per sheet per execution (memoised)
 *   - never getRange() inside a loop over rows
 *   - all writes go through setValues()/appendRow
 *   - all string writes pass through Utils.safeCell (formula injection)
 * ==================================================================== */
var SheetDB = (function () {

  function ss() {
    if (__MEMO__.__ss) return __MEMO__.__ss;
    var id = getProp(PROP.SPREADSHEET_ID);
    var book;
    if (id) {
      book = SpreadsheetApp.openById(id);
    } else {
      book = SpreadsheetApp.getActiveSpreadsheet();
      if (!book) throw new Error('SPREADSHEET_ID is not configured. Run setupSystem() first.');
    }
    __MEMO__.__ss = book;
    return book;
  }

  function sheet(name) {
    var key = '__sh_' + name;
    if (__MEMO__[key]) return __MEMO__[key];
    var sh = ss().getSheetByName(name);
    if (!sh) throw new Error('Missing sheet "' + name + '". Run setupSystem().');
    __MEMO__[key] = sh;
    return sh;
  }

  function headers(name) {
    return HEADERS[name] || [];
  }

  /**
   * Read an entire sheet as an array of objects.
   * Each object carries `_row` (1-based sheet row) so updates can target a
   * single range without re-scanning.
   */
  function readAll(name) {
    var key = '__rows_' + name;
    if (__MEMO__[key]) return __MEMO__[key];

    var sh = sheet(name);
    var lastRow = sh.getLastRow();
    var hdr = headers(name);
    var rows = [];

    if (lastRow >= 2) {
      var values = sh.getRange(2, 1, lastRow - 1, hdr.length).getValues();
      for (var r = 0; r < values.length; r++) {
        var row = values[r];
        var blank = true;
        for (var c = 0; c < row.length; c++) {
          if (row[c] !== '' && row[c] !== null) { blank = false; break; }
        }
        if (blank) continue;

        var o = { _row: r + 2 };
        for (var i = 0; i < hdr.length; i++) {
          var v = row[i];
          o[hdr[i]] = (v instanceof Date) ? Utils.iso(v) : v;
        }
        rows.push(o);
      }
    }
    __MEMO__[key] = rows;
    return rows;
  }

  /** Invalidate the per-execution memo + shared cache for a sheet. */
  function invalidate(name) {
    delete __MEMO__['__rows_' + name];
    Cache.remove('sheet::' + name);
    if (name === SHEETS.QUERIES) Cache.remove('idx::queries');
    if (name === SHEETS.SETTINGS) { delete __MEMO__.__settings; Cache.remove('settings'); }
    if (name === SHEETS.PERMISSIONS || name === SHEETS.ROLES) Cache.remove('rolePerms');
  }

  /** Convert an object to a row array in header order, sanitised. */
  function toRow(name, obj) {
    var hdr = headers(name);
    var row = [];
    for (var i = 0; i < hdr.length; i++) {
      row.push(Utils.safeCell(obj[hdr[i]] === undefined ? '' : obj[hdr[i]]));
    }
    return row;
  }

  /** Append one record. Returns the object with _row set. */
  function insert(name, obj) {
    var sh = sheet(name);
    sh.appendRow(toRow(name, obj));
    invalidate(name);
    obj._row = sh.getLastRow();
    return obj;
  }

  /** Append many records in ONE setValues call. */
  function insertMany(name, objs) {
    if (!objs || !objs.length) return 0;
    var sh = sheet(name);
    var rows = objs.map(function (o) { return toRow(name, o); });
    var start = sh.getLastRow() + 1;
    sh.getRange(start, 1, rows.length, headers(name).length).setValues(rows);
    invalidate(name);
    return rows.length;
  }

  /** Overwrite a whole record by its _row. */
  function update(name, obj) {
    if (!obj || !obj._row) throw new Error('update() needs a record with _row');
    var sh = sheet(name);
    sh.getRange(obj._row, 1, 1, headers(name).length).setValues([toRow(name, obj)]);
    invalidate(name);
    return obj;
  }

  /** Update several records. Contiguous rows are merged into one write. */
  function updateMany(name, objs) {
    if (!objs || !objs.length) return 0;
    var sh = sheet(name);
    var width = headers(name).length;
    var sorted = objs.slice().sort(function (a, b) { return a._row - b._row; });

    var i = 0;
    while (i < sorted.length) {
      var block = [sorted[i]];
      var j = i + 1;
      while (j < sorted.length && sorted[j]._row === sorted[j - 1]._row + 1) {
        block.push(sorted[j]); j++;
      }
      var values = block.map(function (o) { return toRow(name, o); });
      sh.getRange(block[0]._row, 1, values.length, width).setValues(values);
      i = j;
    }
    invalidate(name);
    return sorted.length;
  }

  /** Find first record where field === value. */
  function findBy(name, field, value) {
    var rows = readAll(name);
    for (var i = 0; i < rows.length; i++) {
      if (String(rows[i][field]) === String(value)) return rows[i];
    }
    return null;
  }

  /** Find all records where field === value. */
  function filterBy(name, field, value) {
    return readAll(name).filter(function (r) { return String(r[field]) === String(value); });
  }

  /** Physically delete rows (hard purge only). Deletes bottom-up. */
  function deleteRows(name, rowNumbers) {
    if (!rowNumbers || !rowNumbers.length) return 0;
    var sh = sheet(name);
    var sorted = rowNumbers.slice().sort(function (a, b) { return b - a; });
    for (var i = 0; i < sorted.length; i++) sh.deleteRow(sorted[i]);
    invalidate(name);
    return sorted.length;
  }

  /**
   * Atomic, never-reused sequence numbers stored in Script Properties.
   * Deleting a query does NOT free its id.
   */
  function nextSequence(key, prefix, width) {
    var lock = LockService.getScriptLock();
    lock.waitLock(APP.LOCK_TIMEOUT_MS);
    try {
      var props = PropertiesService.getScriptProperties();
      var propKey = PROP.SEQ_PREFIX + key;
      var current = parseInt(props.getProperty(propKey) || '0', 10);
      var next = current + 1;
      props.setProperty(propKey, String(next));
      return prefix + Utils.pad(next, width);
    } finally {
      lock.releaseLock();
    }
  }

  /** Ensure a sequence is at least as high as existing data (setup repair). */
  function seedSequence(key, sheetName, idField, prefix) {
    var rows = readAll(sheetName);
    var max = 0;
    for (var i = 0; i < rows.length; i++) {
      var id = String(rows[i][idField] || '');
      if (id.indexOf(prefix) !== 0) continue;
      var n = parseInt(id.substring(prefix.length), 10);
      if (!isNaN(n) && n > max) max = n;
    }
    var props = PropertiesService.getScriptProperties();
    var propKey = PROP.SEQ_PREFIX + key;
    var current = parseInt(props.getProperty(propKey) || '0', 10);
    if (max > current) props.setProperty(propKey, String(max));
    return Math.max(max, current);
  }

  function withLock(fn) {
    var lock = LockService.getScriptLock();
    lock.waitLock(APP.LOCK_TIMEOUT_MS);
    try { return fn(); }
    finally { lock.releaseLock(); }
  }

  return {
    ss: ss, sheet: sheet, headers: headers,
    readAll: readAll, invalidate: invalidate,
    insert: insert, insertMany: insertMany,
    update: update, updateMany: updateMany,
    findBy: findBy, filterBy: filterBy, deleteRows: deleteRows,
    nextSequence: nextSequence, seedSequence: seedSequence, withLock: withLock,
    toRow: toRow
  };
})();


/* ==================================================================== *
 * Settings — key/value store backed by the Settings sheet, cached.
 * ==================================================================== */
var Settings = (function () {

  function all() {
    if (__MEMO__.__settings) return __MEMO__.__settings;
    var cached = Cache.get('settings');
    if (cached) { __MEMO__.__settings = cached; return cached; }

    var map = {};
    var rows = SheetDB.readAll(SHEETS.SETTINGS);
    for (var i = 0; i < rows.length; i++) map[rows[i].Key] = rows[i].Value;
    for (var k in DEFAULT_SETTINGS) if (map[k] === undefined) map[k] = DEFAULT_SETTINGS[k];

    __MEMO__.__settings = map;
    Cache.put('settings', map, APP.CACHE_TTL_LOOKUP);
    return map;
  }

  function get(key, dflt) {
    var v = all()[key];
    return (v === undefined || v === '') ? (dflt !== undefined ? dflt : DEFAULT_SETTINGS[key]) : v;
  }

  function getBool(key) { return Utils.bool(get(key)); }
  function getInt(key, dflt) { return Utils.num(get(key), dflt); }

  function set(key, value, byName) {
    var rows = SheetDB.readAll(SHEETS.SETTINGS);
    var found = null;
    for (var i = 0; i < rows.length; i++) if (rows[i].Key === key) { found = rows[i]; break; }
    var stamp = Utils.iso(Utils.now());
    if (found) {
      found.Value = String(value);
      found.UpdatedAt = stamp;
      found.UpdatedBy = byName || '';
      SheetDB.update(SHEETS.SETTINGS, found);
    } else {
      SheetDB.insert(SHEETS.SETTINGS, {
        Key: key, Value: String(value), UpdatedAt: stamp, UpdatedBy: byName || ''
      });
    }
    delete __MEMO__.__settings;
    Cache.remove('settings');
    return value;
  }

  return { all: all, get: get, getBool: getBool, getInt: getInt, set: set };
})();


/* ========================================================================== *
 * SECTION 03 — ActivityLogs.gs
 * Log and Usage — the audit trail.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — ActivityLogs.gs
 * ----------------------------------------------------------------------------
 * Append-only audit trail. Every state change and every sensitive read is
 * recorded here. Reading the log requires VIEW_ACTIVITY_LOG.
 * ============================================================================
 */

/** Canonical action names. Keep in sync with docs/USER_GUIDE.md. */
var ACTIONS = [
  'LOGIN', 'LOGOUT', 'CHANGE_PASSWORD',
  'CREATE_QUERY', 'EDIT_QUERY', 'VIEW_QUERY', 'COPY_SQL', 'DOWNLOAD_SQL',
  'DELETE_QUERY', 'RESTORE_QUERY', 'PURGE_QUERY', 'DUPLICATE_QUERY',
  'FAVORITE_QUERY', 'UNFAVORITE_QUERY',
  'SHARE_QUERY', 'UNSHARE_QUERY',
  'RESTORE_VERSION', 'VIEW_VERSION',
  'CREATE_USER', 'UPDATE_USER', 'DELETE_USER', 'RESET_SESSION',
  'CHANGE_PERMISSION',
  'CREATE_CATEGORY', 'UPDATE_CATEGORY', 'DELETE_CATEGORY',
  'CREATE_DATABASE', 'UPDATE_DATABASE', 'DELETE_DATABASE',
  'UPDATE_SETTINGS', 'EXPORT_DATA', 'CREATE_BACKUP',
  'UPLOAD_ATTACHMENT', 'DELETE_ATTACHMENT',
  'ACCESS_DENIED', 'SETUP'
];

var Log = (function () {

  /**
   * Append one audit record. Never throws — logging must not break a request.
   *
   * @param {object} ctx      auth context (may be a partial/anonymous one)
   * @param {string} action   one of ACTIONS
   * @param {string} module   logical area, e.g. 'Queries'
   * @param {string} queryId  related query id, optional
   * @param {string} description human readable summary
   */
  function write(ctx, action, module, queryId, description) {
    try {
      SheetDB.insert(SHEETS.ACTIVITY, {
        LogID: 'LOG-' + Utils.token(24),
        UserID: (ctx && ctx.userId) || 'ANONYMOUS',
        UserName: (ctx && ctx.name) || 'Anonymous',
        Email: (ctx && ctx.email) || '',
        Action: Utils.text(action, 40),
        Module: Utils.text(module, 40),
        QueryID: Utils.text(queryId, 40),
        Description: Utils.text(description, 500),
        Timestamp: Utils.iso(Utils.now()),
        IPAddress: (ctx && ctx.session && ctx.session.IPAddress) || '',
        SessionID: (ctx && ctx.sessionId) || ''
      });
    } catch (e) {
      Utils.logError(e, 'Log.write');
    }
  }

  /** Batch append — preferred when several records are produced at once. */
  function writeMany(ctx, entries) {
    try {
      var stamp = Utils.iso(Utils.now());
      var rows = entries.map(function (e) {
        return {
          LogID: 'LOG-' + Utils.token(24),
          UserID: (ctx && ctx.userId) || 'ANONYMOUS',
          UserName: (ctx && ctx.name) || 'Anonymous',
          Email: (ctx && ctx.email) || '',
          Action: Utils.text(e.action, 40),
          Module: Utils.text(e.module, 40),
          QueryID: Utils.text(e.queryId, 40),
          Description: Utils.text(e.description, 500),
          Timestamp: stamp,
          IPAddress: (ctx && ctx.session && ctx.session.IPAddress) || '',
          SessionID: (ctx && ctx.sessionId) || ''
        };
      });
      SheetDB.insertMany(SHEETS.ACTIVITY, rows);
    } catch (e) {
      Utils.logError(e, 'Log.writeMany');
    }
  }

  /** Record a denied attempt — these are the interesting ones in an audit. */
  function denied(ctx, permission, detail) {
    write(ctx, 'ACCESS_DENIED', 'Security', '',
      'Missing permission ' + permission + (detail ? ' :: ' + detail : ''));
  }

  /**
   * Paged, filtered log read.
   * filters: { page, pageSize, action, module, userId, email, queryId, from, to, search }
   */
  function list(filters) {
    var f = filters || {};
    var rows = SheetDB.readAll(SHEETS.ACTIVITY);

    var action = Utils.text(f.action, 40);
    var module = Utils.text(f.module, 40);
    var userId = Utils.text(f.userId, 60);
    var email = Utils.normEmail(f.email);
    var queryId = Utils.text(f.queryId, 40);
    var search = Utils.text(f.search, 120).toLowerCase();
    var from = f.from ? new Date(f.from).getTime() : null;
    var to = f.to ? new Date(f.to).getTime() + 86399999 : null;

    var out = [];
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      if (action && r.Action !== action) continue;
      if (module && r.Module !== module) continue;
      if (userId && r.UserID !== userId) continue;
      if (email && Utils.normEmail(r.Email) !== email) continue;
      if (queryId && r.QueryID !== queryId) continue;

      if (from || to) {
        var t = new Date(r.Timestamp).getTime();
        if (isNaN(t)) continue;
        if (from && t < from) continue;
        if (to && t > to) continue;
      }
      if (search) {
        var hay = (r.UserName + ' ' + r.Email + ' ' + r.Action + ' ' + r.Description + ' ' + r.QueryID).toLowerCase();
        if (hay.indexOf(search) === -1) continue;
      }
      out.push({
        logId: r.LogID,
        userId: r.UserID,
        userName: r.UserName,
        email: r.Email,
        action: r.Action,
        module: r.Module,
        queryId: r.QueryID,
        description: r.Description,
        timestamp: r.Timestamp,
        sessionId: r.SessionID
      });
    }

    Utils.sortBy(out, 'timestamp', 'desc');

    var page = Utils.clampInt(f.page, 1, 100000, 1);
    var pageSize = Utils.clampInt(f.pageSize, 5, 200, 25);
    var total = out.length;
    var start = (page - 1) * pageSize;

    return {
      rows: out.slice(start, start + pageSize),
      total: total,
      page: page,
      pageSize: pageSize,
      totalPages: Math.max(1, Math.ceil(total / pageSize))
    };
  }

  /** Recent activity for the dashboard timeline. */
  function recent(limit, forUserId) {
    var rows = SheetDB.readAll(SHEETS.ACTIVITY).slice();
    if (forUserId) rows = rows.filter(function (r) { return r.UserID === forUserId; });
    Utils.sortBy(rows, 'Timestamp', 'desc');
    return rows.slice(0, limit || 15).map(function (r) {
      return {
        userName: r.UserName,
        action: r.Action,
        queryId: r.QueryID,
        description: r.Description,
        timestamp: r.Timestamp
      };
    });
  }

  /** Distinct values used to populate the log filter dropdowns. */
  function facets() {
    var rows = SheetDB.readAll(SHEETS.ACTIVITY);
    var actions = {}, modules = {}, users = {};
    for (var i = 0; i < rows.length; i++) {
      if (rows[i].Action) actions[rows[i].Action] = true;
      if (rows[i].Module) modules[rows[i].Module] = true;
      if (rows[i].UserID) users[rows[i].UserID] = rows[i].UserName;
    }
    var userList = [];
    for (var u in users) userList.push({ userId: u, name: users[u] });
    return {
      actions: Object.keys(actions).sort(),
      modules: Object.keys(modules).sort(),
      users: userList.sort(function (a, b) { return a.name > b.name ? 1 : -1; })
    };
  }

  return { write: write, writeMany: writeMany, denied: denied, list: list, recent: recent, facets: facets };
})();


/* ==================================================================== *
 * Usage — lightweight per-user usage tracking that powers
 * "Recently viewed", "Most used" and the per-query UsageCount.
 * ==================================================================== */
var Usage = (function () {

  function record(ctx, queryId, action) {
    try {
      SheetDB.insert(SHEETS.USAGE, {
        UsageID: 'USE-' + Utils.token(24),
        UserID: ctx.userId,
        QueryID: queryId,
        Action: action,
        Timestamp: Utils.iso(Utils.now())
      });
    } catch (e) {
      Utils.logError(e, 'Usage.record');
    }
  }

  /** Query ids the user touched most recently, newest first. */
  function recentForUser(userId, limit) {
    var rows = SheetDB.filterBy(SHEETS.USAGE, 'UserID', userId).slice();
    Utils.sortBy(rows, 'Timestamp', 'desc');
    var seen = {}, out = [];
    for (var i = 0; i < rows.length && out.length < (limit || 10); i++) {
      var id = rows[i].QueryID;
      if (!id || seen[id]) continue;
      seen[id] = true;
      out.push({ queryId: id, timestamp: rows[i].Timestamp, action: rows[i].Action });
    }
    return out;
  }

  /** Global counts by query id for a given action ('' = all actions). */
  function counts(action) {
    var rows = SheetDB.readAll(SHEETS.USAGE);
    var map = {};
    for (var i = 0; i < rows.length; i++) {
      if (action && rows[i].Action !== action) continue;
      var id = rows[i].QueryID;
      if (!id) continue;
      map[id] = (map[id] || 0) + 1;
    }
    return map;
  }

  return { record: record, recentForUser: recentForUser, counts: counts };
})();


/* ========================================================================== *
 * SECTION 04 — Auth.gs
 * Identity, sessions and the permission gate.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Auth.gs
 * ----------------------------------------------------------------------------
 * Identity, sessions, roles and the permission gate.
 *
 * TWO AUTHENTICATION MODES (in priority order)
 *
 *  1. GOOGLE  — the web app is deployed "Execute as: Me" with access limited
 *               to Google accounts. Session.getActiveUser().getEmail() is
 *               resolved SERVER SIDE and can not be spoofed by the browser.
 *               This is the recommended production mode.
 *
 *  2. APP     — a fallback for deployments where getActiveUser() returns an
 *               empty string (consumer Gmail accounts on some deployment
 *               configurations). The user signs in with an application
 *               password; the server issues an opaque session token that the
 *               client returns on every call and that is validated against
 *               the Sessions sheet on every call.
 *
 * THE GOLDEN RULE
 *   Nothing the browser sends is trusted as identity. Role, permissions,
 *   userId and email are ALWAYS resolved on the server from the Users sheet.
 * ============================================================================
 */

var Auth = (function () {

  /* ---------------------------------------------------------------- *
   * Role + permission lookup (cached; small tables)
   * ---------------------------------------------------------------- */

  /** { ROLE-ADMIN: {VIEW_QUERY:true, ...}, ... } */
  function rolePermissionMap() {
    if (__MEMO__.__rolePerms) return __MEMO__.__rolePerms;

    var cached = Cache.get('rolePerms');
    if (cached) { __MEMO__.__rolePerms = cached; return cached; }

    var map = {};
    var rows = SheetDB.readAll(SHEETS.PERMISSIONS);
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      if (!r.RoleID || !r.Permission) continue;
      if (!map[r.RoleID]) map[r.RoleID] = {};
      map[r.RoleID][r.Permission] = Utils.bool(r.Allowed);
    }
    __MEMO__.__rolePerms = map;
    Cache.put('rolePerms', map, APP.CACHE_TTL_LOOKUP);
    return map;
  }

  function permissionsForRole(roleId) {
    var map = rolePermissionMap()[roleId] || {};
    var out = [];
    for (var p in map) if (map[p]) out.push(p);
    return out;
  }

  function roleById(roleId) {
    return SheetDB.findBy(SHEETS.ROLES, 'RoleID', roleId);
  }

  /* ---------------------------------------------------------------- *
   * Users
   * ---------------------------------------------------------------- */

  function userByEmail(email) {
    var target = Utils.normEmail(email);
    if (!target) return null;
    var rows = SheetDB.readAll(SHEETS.USERS);
    for (var i = 0; i < rows.length; i++) {
      if (Utils.normEmail(rows[i].Email) === target) return rows[i];
    }
    return null;
  }

  function userById(userId) {
    return SheetDB.findBy(SHEETS.USERS, 'UserID', userId);
  }

  /** The Google identity of the caller, resolved server side. May be ''. */
  function googleEmail() {
    try {
      var e = Session.getActiveUser().getEmail();
      return Utils.normEmail(e || '');
    } catch (err) {
      return '';
    }
  }

  /* ---------------------------------------------------------------- *
   * Sessions
   * ---------------------------------------------------------------- */

  function timeoutMinutes() {
    return Utils.clampInt(Settings.get('SESSION_TIMEOUT_MIN'), 5, 720, APP.DEFAULT_SESSION_TIMEOUT_MIN);
  }

  function createSession(user, meta) {
    var nowD = Utils.now();
    var sessionId = 'SES-' + Utils.token(36);
    var rec = {
      SessionID: sessionId,
      UserID: user.UserID,
      CreatedAt: Utils.iso(nowD),
      LastActivity: Utils.iso(nowD),
      ExpiresAt: Utils.iso(Utils.addMinutes(nowD, timeoutMinutes())),
      Status: 'ACTIVE',
      UserAgent: Utils.text((meta && meta.userAgent) || '', 300),
      IPAddress: Utils.text((meta && meta.ip) || '', 60)
    };

    // Optional single-session enforcement.
    if (Settings.getBool('SINGLE_SESSION_PER_USER')) {
      var mine = SheetDB.filterBy(SHEETS.SESSIONS, 'UserID', user.UserID);
      var dirty = [];
      for (var i = 0; i < mine.length; i++) {
        if (mine[i].Status === 'ACTIVE') { mine[i].Status = 'REPLACED'; dirty.push(mine[i]); }
      }
      if (dirty.length) SheetDB.updateMany(SHEETS.SESSIONS, dirty);
    }

    SheetDB.insert(SHEETS.SESSIONS, rec);

    user.ActiveSessionID = sessionId;
    user.LastLogin = Utils.iso(nowD);
    SheetDB.update(SHEETS.USERS, user);

    return rec;
  }

  function sessionById(sessionId) {
    if (!sessionId) return null;
    return SheetDB.findBy(SHEETS.SESSIONS, 'SessionID', sessionId);
  }

  /** Slide the expiry window forward. Written at most once a minute. */
  function touchSession(session) {
    if (!session) return;
    var nowD = Utils.now();
    var last = new Date(session.LastActivity);
    if (!isNaN(last.getTime()) && (nowD.getTime() - last.getTime()) < 60000) return;
    session.LastActivity = Utils.iso(nowD);
    session.ExpiresAt = Utils.iso(Utils.addMinutes(nowD, timeoutMinutes()));
    SheetDB.update(SHEETS.SESSIONS, session);
  }

  function endSession(session, status) {
    if (!session) return;
    session.Status = status || 'CLOSED';
    session.LastActivity = Utils.iso(Utils.now());
    SheetDB.update(SHEETS.SESSIONS, session);
  }

  function sessionIsLive(session) {
    if (!session) return false;
    if (session.Status !== 'ACTIVE') return false;
    var exp = new Date(session.ExpiresAt);
    if (isNaN(exp.getTime())) return false;
    return exp.getTime() > Utils.now().getTime();
  }

  /* ---------------------------------------------------------------- *
   * Rate limiting — cheap abuse guard, per user per rolling minute.
   * ---------------------------------------------------------------- */
  function rateLimitExceeded(key) {
    try {
      var bucket = 'rl::' + key + '::' + Math.floor(Utils.now().getTime() / 60000);
      var c = CacheService.getScriptCache();
      var n = parseInt(c.get(bucket) || '0', 10) + 1;
      c.put(bucket, String(n), 120);
      return n > APP.RATE_LIMIT_PER_MIN;
    } catch (e) {
      return false;
    }
  }

  /* ---------------------------------------------------------------- *
   * The context object every API function receives.
   * ---------------------------------------------------------------- */
  function buildContext(user, session, mode) {
    var perms = permissionsForRole(user.RoleID);
    var role = roleById(user.RoleID);
    var permMap = {};
    for (var i = 0; i < perms.length; i++) permMap[perms[i]] = true;

    return {
      ok: true,
      mode: mode,
      userId: user.UserID,
      name: user.Name,
      email: Utils.normEmail(user.Email),
      department: user.Department || '',
      roleId: user.RoleID,
      roleName: role ? role.RoleName : user.RoleID,
      permissions: perms,
      _permMap: permMap,
      sessionId: session ? session.SessionID : '',
      user: user,
      session: session
    };
  }

  /**
   * Resolve the caller. Never trusts client supplied identity.
   * @param {string} clientToken opaque session id from the browser (APP mode)
   * @return {object} context, or { ok:false, message, code }
   */
  function identify(clientToken) {
    // ---- Mode 1: Google identity (preferred) ----------------------
    var gmail = googleEmail();
    if (gmail) {
      var gUser = userByEmail(gmail);

      if (!gUser && Settings.getBool('ALLOW_SELF_REGISTRATION')) {
        gUser = Users.provision(gmail, gmail.split('@')[0], Settings.get('DEFAULT_NEW_USER_ROLE'));
      }
      if (!gUser) {
        return { ok: false, code: 'NO_ACCOUNT', message: 'Your Google account (' + gmail + ') is not registered in this application. Ask an administrator to add you.' };
      }
      if (String(gUser.Status).toUpperCase() !== 'ACTIVE') {
        return { ok: false, code: 'INACTIVE', message: 'Your account is not active. Please contact an administrator.' };
      }

      var gSession = sessionById(gUser.ActiveSessionID);
      if (!sessionIsLive(gSession)) {
        gSession = createSession(gUser, {});
        Log.write(buildContext(gUser, gSession, 'GOOGLE'), 'LOGIN', 'Auth', '', 'Signed in with Google');
      } else {
        touchSession(gSession);
      }
      return buildContext(gUser, gSession, 'GOOGLE');
    }

    // ---- Mode 2: application session token ------------------------
    var tokenId = Utils.text(clientToken, 80);
    if (!tokenId) {
      return { ok: false, code: 'NO_SESSION', message: 'Please sign in to continue.' };
    }
    var session = sessionById(tokenId);
    if (!sessionIsLive(session)) {
      return { ok: false, code: 'SESSION_EXPIRED', message: 'Your session has expired. Please sign in again.' };
    }
    var user = userById(session.UserID);
    if (!user) {
      return { ok: false, code: 'NO_ACCOUNT', message: 'Account not found. Please sign in again.' };
    }
    if (String(user.Status).toUpperCase() !== 'ACTIVE') {
      endSession(session, 'REVOKED');
      return { ok: false, code: 'INACTIVE', message: 'Your account is not active. Please contact an administrator.' };
    }
    touchSession(session);
    return buildContext(user, session, 'APP');
  }

  /** Permission check. The ONLY place permissions are decided. */
  function can(ctx, permission) {
    if (!ctx || !ctx.ok) return false;
    if (!permission) return true;
    return ctx._permMap[permission] === true;
  }

  /**
   * Query-level authorisation.
   * A user may act on a query when they own it, when a share grants it,
   * or when their role carries the "ANY" variant of the permission.
   */
  function canEditQuery(ctx, query) {
    if (!ctx.ok || !query) return false;
    if (can(ctx, 'EDIT_ANY_QUERY')) return true;
    if (!can(ctx, 'EDIT_QUERY')) return false;
    if (Utils.normEmail(query.CreatedByEmail) === ctx.email) return true;
    return Sharing.grantsEdit(ctx, query.QueryID);
  }

  function canDeleteQuery(ctx, query) {
    if (!ctx.ok || !query) return false;
    if (can(ctx, 'DELETE_ANY_QUERY')) return true;
    if (!can(ctx, 'DELETE_QUERY')) return false;
    return Utils.normEmail(query.CreatedByEmail) === ctx.email;
  }

  function canViewQuery(ctx, query) {
    if (!ctx.ok || !query) return false;
    if (!can(ctx, 'VIEW_QUERY')) return false;
    // Everything visible to the organisation by default; shares add the
    // private ones. Tighten here if you later add private queries.
    return true;
  }

  /* ---------------------------------------------------------------- *
   * Explicit application login (APP mode only)
   * ---------------------------------------------------------------- */

  function login(email, password, meta) {
    var mail = Utils.normEmail(email);
    if (!Utils.isEmail(mail)) return Utils.err('Enter a valid email address.', 'BAD_INPUT');

    // Throttle credential stuffing per email address.
    if (rateLimitExceeded('login::' + mail)) {
      return Utils.err('Too many attempts. Please wait a minute and try again.', 'RATE_LIMIT');
    }

    var user = userByEmail(mail);
    var generic = 'Incorrect email or password.';
    if (!user) return Utils.err(generic, 'BAD_CREDENTIALS');

    var lockedUntil = user.LockedUntil ? new Date(user.LockedUntil) : null;
    if (lockedUntil && !isNaN(lockedUntil.getTime()) && lockedUntil.getTime() > Utils.now().getTime()) {
      return Utils.err('This account is temporarily locked. Try again later.', 'LOCKED');
    }
    if (String(user.Status).toUpperCase() !== 'ACTIVE') {
      return Utils.err('Your account is not active. Please contact an administrator.', 'INACTIVE');
    }
    if (!user.PasswordHash) {
      return Utils.err('No application password is set for this account. Sign in with Google, or ask an administrator to set one.', 'NO_PASSWORD');
    }

    var candidate = Utils.hashPassword(String(password || ''), user.PasswordSalt);
    if (!Utils.safeEquals(candidate, user.PasswordHash)) {
      var fails = Utils.num(user.FailedAttempts, 0) + 1;
      user.FailedAttempts = fails;
      if (fails >= 8) user.LockedUntil = Utils.iso(Utils.addMinutes(Utils.now(), 15));
      SheetDB.update(SHEETS.USERS, user);
      return Utils.err(generic, 'BAD_CREDENTIALS');
    }

    user.FailedAttempts = 0;
    user.LockedUntil = '';
    var session = createSession(user, meta);
    var ctx = buildContext(user, session, 'APP');
    Log.write(ctx, 'LOGIN', 'Auth', '', 'Signed in with application password');

    return Utils.ok({
      token: session.SessionID,
      user: publicProfile(ctx),
      mustChangePassword: Utils.bool(user.MustChangePassword)
    }, 'Welcome back, ' + user.Name + '.');
  }

  function logout(ctx) {
    if (!ctx || !ctx.ok) return Utils.ok(null, 'Signed out.');
    Log.write(ctx, 'LOGOUT', 'Auth', '', 'Signed out');
    endSession(ctx.session, 'CLOSED');
    var user = ctx.user;
    user.ActiveSessionID = '';
    user.LastLogout = Utils.iso(Utils.now());
    SheetDB.update(SHEETS.USERS, user);
    return Utils.ok(null, 'You have been signed out.');
  }

  function changePassword(ctx, currentPassword, newPassword) {
    var user = ctx.user;
    if (user.PasswordHash) {
      var candidate = Utils.hashPassword(String(currentPassword || ''), user.PasswordSalt);
      if (!Utils.safeEquals(candidate, user.PasswordHash)) {
        return Utils.err('Your current password is incorrect.', 'BAD_CREDENTIALS');
      }
    }
    var problem = Utils.validatePasswordStrength(newPassword);
    if (problem) return Utils.err(problem, 'WEAK_PASSWORD');

    var salt = Utils.newSalt();
    user.PasswordSalt = salt;
    user.PasswordHash = Utils.hashPassword(newPassword, salt);
    user.MustChangePassword = false;
    SheetDB.update(SHEETS.USERS, user);
    Log.write(ctx, 'CHANGE_PASSWORD', 'Auth', '', 'Password changed');
    return Utils.ok(null, 'Password updated.');
  }

  /** What the browser is allowed to know about the signed in user. */
  function publicProfile(ctx) {
    return {
      userId: ctx.userId,
      name: ctx.name,
      email: ctx.email,
      department: ctx.department,
      roleId: ctx.roleId,
      roleName: ctx.roleName,
      permissions: ctx.permissions,
      authMode: ctx.mode,
      sessionExpiresAt: ctx.session ? ctx.session.ExpiresAt : '',
      initials: (String(ctx.name || ctx.email).replace(/^\s+/, '').charAt(0) || '?').toUpperCase()
    };
  }

  return {
    identify: identify,
    can: can,
    canEditQuery: canEditQuery,
    canDeleteQuery: canDeleteQuery,
    canViewQuery: canViewQuery,
    login: login,
    logout: logout,
    changePassword: changePassword,
    publicProfile: publicProfile,
    permissionsForRole: permissionsForRole,
    rolePermissionMap: rolePermissionMap,
    userByEmail: userByEmail,
    userById: userById,
    googleEmail: googleEmail,
    createSession: createSession,
    endSession: endSession,
    sessionById: sessionById,
    sessionIsLive: sessionIsLive,
    timeoutMinutes: timeoutMinutes,
    rateLimitExceeded: rateLimitExceeded
  };
})();


/* ========================================================================== *
 * SECTION 05 — Queries.gs
 * The core domain: CRUD, search, filter, paging, dashboard.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Queries.gs
 * ----------------------------------------------------------------------------
 * The core domain module: create, read, search, filter, page, edit, soft
 * delete, restore, purge and duplicate SQL queries.
 *
 * Performance contract:
 *   - the Queries sheet is read ONCE per execution (SheetDB memo)
 *   - a slimmed "index" (everything except the SQL body) is cached so list
 *     views never ship whole SQL bodies to the browser
 *   - filtering, searching, sorting and paging all happen SERVER SIDE
 * ============================================================================
 */

var Queries = (function () {

  /* ---------------------------------------------------------------- *
   * Lookups
   * ---------------------------------------------------------------- */

  function categoryMap() {
    if (__MEMO__.__catMap) return __MEMO__.__catMap;
    var map = {};
    SheetDB.readAll(SHEETS.CATEGORIES).forEach(function (c) {
      map[c.CategoryID] = c.CategoryName;
    });
    __MEMO__.__catMap = map;
    return map;
  }

  function databaseMap() {
    if (__MEMO__.__dbMap) return __MEMO__.__dbMap;
    var map = {};
    SheetDB.readAll(SHEETS.DATABASES).forEach(function (d) {
      map[d.DatabaseID] = { name: d.DatabaseName, env: d.Environment };
    });
    __MEMO__.__dbMap = map;
    return map;
  }

  /** Row -> list item (no SQL body). */
  function toListItem(row) {
    var cats = categoryMap();
    var dbs = databaseMap();
    var db = dbs[row.DatabaseID] || { name: '', env: '' };
    return {
      queryId: row.QueryID,
      name: row.QueryName,
      description: row.Description,
      categoryId: row.CategoryID,
      category: cats[row.CategoryID] || '',
      databaseId: row.DatabaseID,
      database: db.name,
      environment: db.env,
      tags: String(row.Tags || '').split(',').map(function (t) { return t.trim(); }).filter(Boolean),
      status: row.Status || 'Active',
      createdBy: row.CreatedBy,
      createdByEmail: Utils.normEmail(row.CreatedByEmail),
      createdAt: row.CreatedAt,
      updatedBy: row.UpdatedBy,
      updatedByEmail: Utils.normEmail(row.UpdatedByEmail),
      updatedAt: row.UpdatedAt,
      version: String(row.Version || '1.0'),
      usageCount: Utils.num(row.UsageCount, 0),
      lastUsedAt: row.LastUsedAt,
      driveFileUrl: row.DriveFileURL || '',
      isDeleted: Utils.bool(row.IsDeleted)
    };
  }

  /** Row -> full detail (includes SQL body). */
  function toDetail(row, ctx) {
    var item = toListItem(row);
    item.sql = row.SQLCode || '';
    item.driveFileId = row.DriveFileID || '';
    item.deletedBy = row.DeletedBy || '';
    item.deletedAt = row.DeletedAt || '';
    item.canEdit = Auth.canEditQuery(ctx, row);
    item.canDelete = Auth.canDeleteQuery(ctx, row);
    item.isOwner = Utils.normEmail(row.CreatedByEmail) === ctx.email;
    return item;
  }

  function findRow(queryId) {
    return SheetDB.findBy(SHEETS.QUERIES, 'QueryID', Utils.text(queryId, 40));
  }

  /* ---------------------------------------------------------------- *
   * Search index — the slim list projection, cached across executions.
   * ---------------------------------------------------------------- */
  function index() {
    if (__MEMO__.__qIndex) return __MEMO__.__qIndex;

    var cached = Cache.get('idx::queries');
    if (cached) { __MEMO__.__qIndex = cached; return cached; }

    var rows = SheetDB.readAll(SHEETS.QUERIES);
    var out = [];
    for (var i = 0; i < rows.length; i++) {
      var item = toListItem(rows[i]);
      // Haystack includes the SQL body so full text search works without
      // shipping the SQL to the browser.
      item._hay = [
        item.queryId, item.name, item.description, item.category,
        item.database, item.tags.join(' '), item.createdBy, item.updatedBy,
        rows[i].SQLCode
      ].join(' ').toLowerCase();
      out.push(item);
    }
    __MEMO__.__qIndex = out;
    Cache.put('idx::queries', out, APP.CACHE_TTL_INDEX);
    return out;
  }

  /* ---------------------------------------------------------------- *
   * list()
   *
   * filters: {
   *   scope: all | mine | favorites | shared | recent | trash,
   *   search, categoryId, databaseId, status, tag, createdByEmail,
   *   updatedByEmail, createdFrom, createdTo, updatedFrom, updatedTo,
   *   sort, dir, page, pageSize
   * }
   * ---------------------------------------------------------------- */
  function list(ctx, filters) {
    var f = filters || {};
    var scope = Utils.text(f.scope, 20) || 'all';
    var rows = index().slice();

    // --- scope ---------------------------------------------------
    var favIds = Favorites.idsForUser(ctx.userId);
    var favSet = {};
    favIds.forEach(function (id) { favSet[id] = true; });

    if (scope === 'trash') {
      rows = rows.filter(function (r) { return r.isDeleted; });
    } else {
      rows = rows.filter(function (r) { return !r.isDeleted; });
    }

    if (scope === 'mine') {
      rows = rows.filter(function (r) { return r.createdByEmail === ctx.email; });
    } else if (scope === 'favorites') {
      rows = rows.filter(function (r) { return favSet[r.queryId]; });
    } else if (scope === 'shared') {
      var sharedIds = Sharing.idsSharedWith(ctx.email);
      var sharedSet = {};
      sharedIds.forEach(function (id) { sharedSet[id] = true; });
      rows = rows.filter(function (r) { return sharedSet[r.queryId]; });
    } else if (scope === 'recent') {
      var recent = Usage.recentForUser(ctx.userId, 50);
      var order = {};
      recent.forEach(function (u, i) { order[u.queryId] = i; });
      rows = rows.filter(function (r) { return order[r.queryId] !== undefined; });
      rows.sort(function (a, b) { return order[a.queryId] - order[b.queryId]; });
    }

    // --- attribute filters ---------------------------------------
    var search = Utils.text(f.search, 200).toLowerCase();
    var categoryId = Utils.text(f.categoryId, 40);
    var databaseId = Utils.text(f.databaseId, 40);
    var status = Utils.text(f.status, 30);
    var tag = Utils.text(f.tag, 60).toLowerCase();
    var createdBy = Utils.normEmail(f.createdByEmail);
    var updatedBy = Utils.normEmail(f.updatedByEmail);

    var cFrom = f.createdFrom ? new Date(f.createdFrom).getTime() : null;
    var cTo = f.createdTo ? new Date(f.createdTo).getTime() + 86399999 : null;
    var uFrom = f.updatedFrom ? new Date(f.updatedFrom).getTime() : null;
    var uTo = f.updatedTo ? new Date(f.updatedTo).getTime() + 86399999 : null;

    var terms = search ? search.split(/\s+/).filter(Boolean) : [];

    rows = rows.filter(function (r) {
      if (categoryId && r.categoryId !== categoryId) return false;
      if (databaseId && r.databaseId !== databaseId) return false;
      if (status && String(r.status) !== status) return false;
      if (createdBy && r.createdByEmail !== createdBy) return false;
      if (updatedBy && r.updatedByEmail !== updatedBy) return false;

      if (tag) {
        var hit = false;
        for (var t = 0; t < r.tags.length; t++) {
          if (r.tags[t].toLowerCase() === tag) { hit = true; break; }
        }
        if (!hit) return false;
      }

      if (cFrom || cTo) {
        var ct = new Date(r.createdAt).getTime();
        if (isNaN(ct)) return false;
        if (cFrom && ct < cFrom) return false;
        if (cTo && ct > cTo) return false;
      }
      if (uFrom || uTo) {
        var ut = new Date(r.updatedAt).getTime();
        if (isNaN(ut)) return false;
        if (uFrom && ut < uFrom) return false;
        if (uTo && ut > uTo) return false;
      }

      // Every term must appear somewhere (AND semantics).
      for (var i = 0; i < terms.length; i++) {
        if (r._hay.indexOf(terms[i]) === -1) return false;
      }
      return true;
    });

    // --- sort ----------------------------------------------------
    if (scope !== 'recent') {
      var sortKey = ({
        name: 'name', id: 'queryId', category: 'category', database: 'database',
        createdAt: 'createdAt', updatedAt: 'updatedAt', usage: 'usageCount', status: 'status'
      })[Utils.text(f.sort, 20)] || 'updatedAt';
      var dir = (f.dir === 'asc') ? 'asc' : 'desc';
      Utils.sortBy(rows, sortKey, dir);
    }

    // --- page ----------------------------------------------------
    var page = Utils.clampInt(f.page, 1, 100000, 1);
    var pageSize = Utils.clampInt(f.pageSize, 5, 200, Settings.getInt('DEFAULT_PAGE_SIZE', APP.DEFAULT_PAGE_SIZE));
    var total = rows.length;
    var totalPages = Math.max(1, Math.ceil(total / pageSize));
    if (page > totalPages) page = totalPages;
    var slice = rows.slice((page - 1) * pageSize, (page - 1) * pageSize + pageSize);

    // Strip the search haystack and attach per-user flags.
    var out = slice.map(function (r) {
      var copy = {};
      for (var k in r) if (k !== '_hay') copy[k] = r[k];
      copy.isFavorite = !!favSet[r.queryId];
      return copy;
    });

    return {
      rows: out,
      total: total,
      page: page,
      pageSize: pageSize,
      totalPages: totalPages,
      scope: scope
    };
  }

  /** Typeahead for the Ctrl+K palette — ids and names only. */
  function quickSearch(ctx, term, limit) {
    var q = Utils.text(term, 100).toLowerCase();
    if (!q) return [];
    var rows = index();
    var out = [];
    for (var i = 0; i < rows.length && out.length < (limit || 8); i++) {
      var r = rows[i];
      if (r.isDeleted) continue;
      if (r._hay.indexOf(q) === -1) continue;
      out.push({
        queryId: r.queryId, name: r.name, category: r.category,
        database: r.database, status: r.status
      });
    }
    return out;
  }

  /* ---------------------------------------------------------------- *
   * get()
   * ---------------------------------------------------------------- */
  function get(ctx, queryId, recordView) {
    var row = findRow(queryId);
    if (!row) return Utils.err('That query could not be found.', 'NOT_FOUND');
    if (!Auth.canViewQuery(ctx, row)) return Utils.err('You do not have permission to view this query.', 'FORBIDDEN');

    var detail = toDetail(row, ctx);
    detail.isFavorite = Favorites.isFavorite(ctx.userId, row.QueryID);
    detail.versionCount = Versions.countFor(row.QueryID);
    detail.shares = Sharing.forQuery(ctx, row.QueryID);
    detail.attachments = DriveService.attachmentsFor(row.QueryID);

    if (recordView) {
      Usage.record(ctx, row.QueryID, 'VIEW');
      Log.write(ctx, 'VIEW_QUERY', 'Queries', row.QueryID, 'Opened ' + row.QueryName);
      bumpUsage_(row);
    }
    return Utils.ok(detail);
  }

  function bumpUsage_(row) {
    try {
      row.UsageCount = Utils.num(row.UsageCount, 0) + 1;
      row.LastUsedAt = Utils.iso(Utils.now());
      SheetDB.update(SHEETS.QUERIES, row);
    } catch (e) {
      Utils.logError(e, 'bumpUsage_');
    }
  }

  /* ---------------------------------------------------------------- *
   * Validation shared by create() and update()
   * ---------------------------------------------------------------- */
  function validate(data, isUpdate) {
    var errors = [];
    var name = Utils.text(data.name, APP.MAX_QUERY_NAME);
    var sql = Utils.sqlText(data.sql, APP.MAX_SQL);
    var categoryId = Utils.text(data.categoryId, 40);
    var databaseId = Utils.text(data.databaseId, 40);

    if (!name) errors.push('Query name is required.');
    if (!sql) errors.push('SQL code is required.');
    if (!categoryId) errors.push('Category is required.');
    if (!databaseId) errors.push('Database is required.');

    if (categoryId && !categoryMap()[categoryId]) errors.push('That category does not exist.');
    if (databaseId && !databaseMap()[databaseId]) errors.push('That database does not exist.');

    var status = Utils.text(data.status, 30) || 'Active';
    if (['Active', 'Draft', 'Archived', 'Deprecated'].indexOf(status) === -1) {
      errors.push('Status must be Active, Draft, Archived or Deprecated.');
    }

    return {
      errors: errors,
      clean: {
        name: name,
        description: Utils.sqlText(data.description, APP.MAX_DESCRIPTION),
        categoryId: categoryId,
        databaseId: databaseId,
        sql: sql,
        tags: Utils.tags(data.tags),
        status: status
      }
    };
  }

  /* ---------------------------------------------------------------- *
   * create()
   * ---------------------------------------------------------------- */
  function create(ctx, data) {
    var v = validate(data, false);
    if (v.errors.length) return Utils.err(v.errors.join(' '), 'VALIDATION');

    return SheetDB.withLock(function () {
      var stamp = Utils.iso(Utils.now());
      var id = SheetDB.nextSequence('QUERY', 'SQL-', 6);

      var row = {
        QueryID: id,
        QueryName: v.clean.name,
        Description: v.clean.description,
        CategoryID: v.clean.categoryId,
        DatabaseID: v.clean.databaseId,
        SQLCode: v.clean.sql,
        Tags: v.clean.tags,
        Status: v.clean.status,
        CreatedBy: ctx.name,
        CreatedByEmail: ctx.email,
        CreatedAt: stamp,
        UpdatedBy: ctx.name,
        UpdatedByEmail: ctx.email,
        UpdatedAt: stamp,
        IsFavorite: '',
        IsDeleted: 'FALSE',
        DeletedBy: '',
        DeletedAt: '',
        DriveFileID: '',
        DriveFileURL: '',
        Version: '1.0',
        UsageCount: 0,
        LastUsedAt: ''
      };

      // Optional Drive .sql mirror
      if (Settings.getBool('ALLOW_DRIVE_FILES') && Settings.getBool('AUTO_CREATE_DRIVE_SQL_FILE')) {
        var file = DriveService.writeSqlFile(id, v.clean.name, v.clean.sql);
        if (file) { row.DriveFileID = file.id; row.DriveFileURL = file.url; }
      }

      SheetDB.insert(SHEETS.QUERIES, row);
      Versions.snapshot(ctx, row, '1.0', 'Initial version');
      Log.write(ctx, 'CREATE_QUERY', 'Queries', id, 'Created ' + v.clean.name);
      Usage.record(ctx, id, 'CREATE');

      return Utils.ok(toDetail(row, ctx), 'Query ' + id + ' created.');
    });
  }

  /* ---------------------------------------------------------------- *
   * update() — always snapshots the OUTGOING version first.
   * ---------------------------------------------------------------- */
  function update(ctx, queryId, data) {
    var row = findRow(queryId);
    if (!row) return Utils.err('That query could not be found.', 'NOT_FOUND');
    if (Utils.bool(row.IsDeleted)) return Utils.err('Restore this query from Trash before editing it.', 'DELETED');
    if (!Auth.canEditQuery(ctx, row)) {
      Log.denied(ctx, 'EDIT_QUERY', queryId);
      return Utils.err('You do not have permission to edit this query.', 'FORBIDDEN');
    }

    var v = validate(data, true);
    if (v.errors.length) return Utils.err(v.errors.join(' '), 'VALIDATION');

    return SheetDB.withLock(function () {
      var fresh = findRow(queryId);      // re-read inside the lock
      var changes = describeChanges_(fresh, v.clean);
      if (!changes.length && !Utils.text(data.changeSummary, 200)) {
        return Utils.ok(toDetail(fresh, ctx), 'No changes to save.');
      }

      // 1. make sure the version being replaced is safely in history
      Versions.ensureBaseline(ctx, fresh);

      // 2. bump — a changed SQL body is a major version, metadata is minor
      var sqlChanged = (String(fresh.SQLCode || '') !== v.clean.sql);
      var nextVersion = Versions.bump(Versions.highest(queryId), sqlChanged ? 'major' : 'minor');
      var stamp = Utils.iso(Utils.now());

      fresh.QueryName = v.clean.name;
      fresh.Description = v.clean.description;
      fresh.CategoryID = v.clean.categoryId;
      fresh.DatabaseID = v.clean.databaseId;
      fresh.SQLCode = v.clean.sql;
      fresh.Tags = v.clean.tags;
      fresh.Status = v.clean.status;
      fresh.UpdatedBy = ctx.name;
      fresh.UpdatedByEmail = ctx.email;
      fresh.UpdatedAt = stamp;
      fresh.Version = nextVersion;

      if (sqlChanged && Settings.getBool('ALLOW_DRIVE_FILES') && fresh.DriveFileID) {
        DriveService.updateSqlFile(fresh.DriveFileID, v.clean.sql);
      }

      SheetDB.update(SHEETS.QUERIES, fresh);

      // 3. record the NEW version too, with the human summary
      var summary = Utils.text(data.changeSummary, 200) || changes.join('; ');
      Versions.snapshot(ctx, fresh, nextVersion, summary);

      Log.write(ctx, 'EDIT_QUERY', 'Queries', queryId,
        'Updated to v' + nextVersion + ' — ' + summary);
      Usage.record(ctx, queryId, 'EDIT');
      Notifications.queryUpdated(ctx, fresh, summary);

      return Utils.ok(toDetail(fresh, ctx), 'Saved as version ' + nextVersion + '.');
    });
  }

  function describeChanges_(row, clean) {
    var out = [];
    if (String(row.QueryName) !== clean.name) out.push('renamed');
    if (String(row.Description || '') !== clean.description) out.push('description updated');
    if (String(row.CategoryID) !== clean.categoryId) out.push('category changed');
    if (String(row.DatabaseID) !== clean.databaseId) out.push('database changed');
    if (String(row.Tags || '') !== clean.tags) out.push('tags updated');
    if (String(row.Status || '') !== clean.status) out.push('status -> ' + clean.status);
    if (String(row.SQLCode || '') !== clean.sql) out.push('SQL modified');
    return out;
  }

  /* ---------------------------------------------------------------- *
   * Trash lifecycle
   * ---------------------------------------------------------------- */
  function softDelete(ctx, queryId) {
    var row = findRow(queryId);
    if (!row) return Utils.err('That query could not be found.', 'NOT_FOUND');
    if (!Auth.canDeleteQuery(ctx, row)) {
      Log.denied(ctx, 'DELETE_QUERY', queryId);
      return Utils.err('You do not have permission to delete this query.', 'FORBIDDEN');
    }
    if (Utils.bool(row.IsDeleted)) return Utils.ok(null, 'Already in Trash.');

    row.IsDeleted = 'TRUE';
    row.DeletedBy = ctx.name;
    row.DeletedAt = Utils.iso(Utils.now());
    SheetDB.update(SHEETS.QUERIES, row);

    Log.write(ctx, 'DELETE_QUERY', 'Queries', queryId, 'Moved to Trash: ' + row.QueryName);
    Notifications.queryDeleted(ctx, row);
    return Utils.ok(null, row.QueryID + ' moved to Trash.');
  }

  function restore(ctx, queryId) {
    if (!Auth.can(ctx, 'RESTORE_QUERY')) {
      Log.denied(ctx, 'RESTORE_QUERY', queryId);
      return Utils.err('You do not have permission to restore queries.', 'FORBIDDEN');
    }
    var row = findRow(queryId);
    if (!row) return Utils.err('That query could not be found.', 'NOT_FOUND');
    if (!Utils.bool(row.IsDeleted)) return Utils.ok(null, 'That query is not in Trash.');

    row.IsDeleted = 'FALSE';
    row.DeletedBy = '';
    row.DeletedAt = '';
    row.UpdatedBy = ctx.name;
    row.UpdatedByEmail = ctx.email;
    row.UpdatedAt = Utils.iso(Utils.now());
    SheetDB.update(SHEETS.QUERIES, row);

    Log.write(ctx, 'RESTORE_QUERY', 'Queries', queryId, 'Restored from Trash: ' + row.QueryName);
    return Utils.ok(null, row.QueryID + ' restored.');
  }

  /** Permanent removal. Admin only. Versions and history are removed too. */
  function purge(ctx, queryId) {
    if (!Auth.can(ctx, 'PURGE_QUERY')) {
      Log.denied(ctx, 'PURGE_QUERY', queryId);
      return Utils.err('Only an administrator can permanently delete a query.', 'FORBIDDEN');
    }
    var row = findRow(queryId);
    if (!row) return Utils.err('That query could not be found.', 'NOT_FOUND');
    if (!Utils.bool(row.IsDeleted)) {
      return Utils.err('Move the query to Trash before deleting it permanently.', 'BAD_STATE');
    }

    return SheetDB.withLock(function () {
      var name = row.QueryName;

      // Detach the Drive mirror (moved to trash, not hard deleted).
      if (row.DriveFileID) DriveService.trashFile(row.DriveFileID);

      var versionRows = SheetDB.filterBy(SHEETS.VERSIONS, 'QueryID', queryId).map(function (r) { return r._row; });
      SheetDB.deleteRows(SHEETS.VERSIONS, versionRows);

      var favRows = SheetDB.filterBy(SHEETS.FAVORITES, 'QueryID', queryId).map(function (r) { return r._row; });
      SheetDB.deleteRows(SHEETS.FAVORITES, favRows);

      var shareRows = SheetDB.filterBy(SHEETS.SHARES, 'QueryID', queryId).map(function (r) { return r._row; });
      SheetDB.deleteRows(SHEETS.SHARES, shareRows);

      var attRows = SheetDB.filterBy(SHEETS.ATTACHMENTS, 'QueryID', queryId).map(function (r) { return r._row; });
      SheetDB.deleteRows(SHEETS.ATTACHMENTS, attRows);

      var again = findRow(queryId);
      if (again) SheetDB.deleteRows(SHEETS.QUERIES, [again._row]);

      // NOTE: the ID sequence is never rolled back, so this id is never reused.
      Log.write(ctx, 'PURGE_QUERY', 'Queries', queryId, 'Permanently deleted: ' + name);
      return Utils.ok(null, queryId + ' permanently deleted.');
    });
  }

  /** Duplicate an existing query as a new draft owned by the caller. */
  function duplicate(ctx, queryId) {
    if (!Auth.can(ctx, 'CREATE_QUERY')) {
      Log.denied(ctx, 'CREATE_QUERY', queryId);
      return Utils.err('You do not have permission to create queries.', 'FORBIDDEN');
    }
    var row = findRow(queryId);
    if (!row) return Utils.err('That query could not be found.', 'NOT_FOUND');

    var res = create(ctx, {
      name: Utils.text(row.QueryName + ' (copy)', APP.MAX_QUERY_NAME),
      description: row.Description,
      categoryId: row.CategoryID,
      databaseId: row.DatabaseID,
      sql: row.SQLCode,
      tags: row.Tags,
      status: 'Draft'
    });
    if (res.success) {
      Log.write(ctx, 'DUPLICATE_QUERY', 'Queries', res.data.queryId, 'Duplicated from ' + queryId);
    }
    return res;
  }

  /** Record a clipboard copy (audited, per section 18 of the spec). */
  function recordCopy(ctx, queryId) {
    var row = findRow(queryId);
    if (!row) return Utils.err('That query could not be found.', 'NOT_FOUND');
    if (!Auth.can(ctx, 'COPY_SQL')) {
      Log.denied(ctx, 'COPY_SQL', queryId);
      return Utils.err('You do not have permission to copy SQL.', 'FORBIDDEN');
    }
    Usage.record(ctx, queryId, 'COPY');
    Log.write(ctx, 'COPY_SQL', 'Queries', queryId, 'Copied SQL of ' + row.QueryName);
    bumpUsage_(row);
    return Utils.ok({ queryId: queryId }, 'SQL query copied to clipboard');
  }

  /** Return the .sql payload for a browser side download. */
  function downloadPayload(ctx, queryId) {
    var row = findRow(queryId);
    if (!row) return Utils.err('That query could not be found.', 'NOT_FOUND');
    if (!Auth.can(ctx, 'COPY_SQL')) return Utils.err('You do not have permission to download SQL.', 'FORBIDDEN');

    Log.write(ctx, 'DOWNLOAD_SQL', 'Queries', queryId, 'Downloaded ' + row.QueryName);
    Usage.record(ctx, queryId, 'DOWNLOAD');

    return Utils.ok({
      filename: DriveService.sqlFileName(row.QueryID, row.QueryName),
      content: sqlFileBody_(row)
    });
  }

  /** File header + body used for .sql exports and the Drive mirror. */
  function sqlFileBody_(row) {
    var cats = categoryMap(), dbs = databaseMap();
    var db = dbs[row.DatabaseID] || { name: '', env: '' };
    return [
      '-- ============================================================',
      '-- ' + row.QueryID + ' :: ' + row.QueryName,
      '-- Category   : ' + (cats[row.CategoryID] || ''),
      '-- Database   : ' + db.name + (db.env ? ' (' + db.env + ')' : ''),
      '-- Version    : ' + (row.Version || '1.0'),
      '-- Updated by : ' + row.UpdatedBy + ' on ' + Utils.fmt(row.UpdatedAt),
      '-- Exported   : ' + Utils.fmt(Utils.now()) + ' from ' + APP.NAME,
      '-- ============================================================',
      '',
      row.SQLCode || ''
    ].join('\n');
  }

  /* ---------------------------------------------------------------- *
   * Dashboard
   * ---------------------------------------------------------------- */
  function dashboard(ctx) {
    var all = index();
    var live = all.filter(function (r) { return !r.isDeleted; });

    var favIds = Favorites.idsForUser(ctx.userId);
    var counts = Usage.counts('');

    var byCategory = {};
    var byDatabase = {};
    var byStatus = {};
    for (var i = 0; i < live.length; i++) {
      var r = live[i];
      byCategory[r.category || 'Uncategorised'] = (byCategory[r.category || 'Uncategorised'] || 0) + 1;
      byDatabase[r.database || 'Unknown'] = (byDatabase[r.database || 'Unknown'] || 0) + 1;
      byStatus[r.status || 'Active'] = (byStatus[r.status || 'Active'] || 0) + 1;
    }

    var recentlyUpdated = live.slice();
    Utils.sortBy(recentlyUpdated, 'updatedAt', 'desc');

    var mostUsed = live.slice().map(function (r) {
      return { queryId: r.queryId, name: r.name, category: r.category, usageCount: Math.max(r.usageCount, counts[r.queryId] || 0) };
    });
    Utils.sortBy(mostUsed, 'usageCount', 'desc');

    var myRecent = Usage.recentForUser(ctx.userId, 8);
    var byId = {};
    live.forEach(function (r) { byId[r.queryId] = r; });
    var myRecentRows = myRecent
      .map(function (u) {
        var q = byId[u.queryId];
        return q ? { queryId: q.queryId, name: q.name, category: q.category, timestamp: u.timestamp, action: u.action } : null;
      })
      .filter(Boolean);

    var mine = live.filter(function (r) { return r.createdByEmail === ctx.email; });

    function toPairs(map) {
      var arr = [];
      for (var k in map) arr.push({ label: k, count: map[k] });
      return arr.sort(function (a, b) { return b.count - a.count; });
    }

    return {
      stats: {
        totalQueries: live.length,
        activeQueries: live.filter(function (r) { return r.status === 'Active'; }).length,
        draftQueries: live.filter(function (r) { return r.status === 'Draft'; }).length,
        categories: SheetDB.readAll(SHEETS.CATEGORIES).filter(function (c) { return c.Status === 'Active'; }).length,
        databases: SheetDB.readAll(SHEETS.DATABASES).filter(function (d) { return d.Status === 'Active'; }).length,
        myQueries: mine.length,
        favorites: favIds.length,
        trash: all.length - live.length,
        users: SheetDB.readAll(SHEETS.USERS).filter(function (u) { return String(u.Status).toUpperCase() === 'ACTIVE'; }).length
      },
      recentlyUpdated: recentlyUpdated.slice(0, 8).map(strip_),
      mostUsed: mostUsed.slice(0, 8),
      myRecent: myRecentRows,
      byCategory: toPairs(byCategory),
      byDatabase: toPairs(byDatabase),
      byStatus: toPairs(byStatus),
      activity: Auth.can(ctx, 'VIEW_ACTIVITY_LOG') ? Log.recent(12) : Log.recent(12, ctx.userId)
    };
  }

  function strip_(r) {
    var copy = {};
    for (var k in r) if (k !== '_hay') copy[k] = r[k];
    return copy;
  }

  /** Distinct tag cloud for the filter dropdown. */
  function allTags() {
    var seen = {};
    index().forEach(function (r) {
      if (r.isDeleted) return;
      r.tags.forEach(function (t) { seen[t] = (seen[t] || 0) + 1; });
    });
    var out = [];
    for (var t in seen) out.push({ tag: t, count: seen[t] });
    return out.sort(function (a, b) { return b.count - a.count; });
  }

  /** Distinct authors, for the "Created By" filter. */
  function allAuthors() {
    var seen = {};
    index().forEach(function (r) {
      if (r.createdByEmail) seen[r.createdByEmail] = r.createdBy;
    });
    var out = [];
    for (var e in seen) out.push({ email: e, name: seen[e] });
    return out.sort(function (a, b) { return a.name > b.name ? 1 : -1; });
  }

  return {
    list: list,
    quickSearch: quickSearch,
    get: get,
    create: create,
    update: update,
    softDelete: softDelete,
    restore: restore,
    purge: purge,
    duplicate: duplicate,
    recordCopy: recordCopy,
    downloadPayload: downloadPayload,
    dashboard: dashboard,
    allTags: allTags,
    allAuthors: allAuthors,
    findRow: findRow,
    toListItem: toListItem,
    toDetail: toDetail,
    categoryMap: categoryMap,
    databaseMap: databaseMap,
    sqlFileBody: sqlFileBody_,
    index: index
  };
})();


/* ========================================================================== *
 * SECTION 06 — Versions.gs
 * Immutable version history, line diff and restore.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Versions.gs
 * ----------------------------------------------------------------------------
 * Immutable version history.
 *
 * MODEL
 *   The QueryVersions sheet holds one row for EVERY version that has ever
 *   existed, including the version that is currently live. Nothing is ever
 *   overwritten or deleted (except when a query is purged by an Admin).
 *
 * NUMBERING
 *   SQL body changed        -> major bump   1.4 -> 2.0
 *   metadata only changed   -> minor bump   1.4 -> 1.5
 *   restore of an old one   -> major bump, and the restored body becomes the
 *                              new HIGHEST version. The current version is
 *                              never destroyed:
 *                                   current = V3.0, restore V1.0  =>  V4.0
 * ============================================================================
 */

var Versions = (function () {

  /** Append a version row. */
  function snapshot(ctx, row, versionNumber, summary) {
    SheetDB.insert(SHEETS.VERSIONS, {
      VersionID: 'VER-' + Utils.token(20),
      QueryID: row.QueryID,
      VersionNumber: String(versionNumber),
      SQLCode: row.SQLCode || '',
      Description: row.Description || '',
      ChangedBy: ctx.name,
      ChangedByEmail: ctx.email,
      ChangedAt: Utils.iso(Utils.now()),
      ChangeSummary: Utils.text(summary, 300)
    });
  }

  /**
   * Guarantee the currently live version exists in history.
   * Protects data that was pasted into the sheet by hand.
   */
  function ensureBaseline(ctx, row) {
    var current = String(row.Version || '1.0');
    var rows = SheetDB.filterBy(SHEETS.VERSIONS, 'QueryID', row.QueryID);
    for (var i = 0; i < rows.length; i++) {
      if (String(rows[i].VersionNumber) === current) return false;
    }
    snapshot(ctx, row, current, 'Baseline captured automatically');
    return true;
  }

  /** '1.4' + major -> '2.0'; '1.4' + minor -> '1.5' */
  function bump(version, kind) {
    var parts = String(version || '1.0').split('.');
    var major = parseInt(parts[0], 10); if (isNaN(major)) major = 1;
    var minor = parseInt(parts[1], 10); if (isNaN(minor)) minor = 0;
    if (kind === 'major') return (major + 1) + '.0';
    return major + '.' + (minor + 1);
  }

  function compareVersionNumbers(a, b) {
    var pa = String(a).split('.'), pb = String(b).split('.');
    var ma = parseInt(pa[0], 10) || 0, mb = parseInt(pb[0], 10) || 0;
    if (ma !== mb) return ma - mb;
    return (parseInt(pa[1], 10) || 0) - (parseInt(pb[1], 10) || 0);
  }

  /** Highest version number recorded for a query. */
  function highest(queryId) {
    var rows = SheetDB.filterBy(SHEETS.VERSIONS, 'QueryID', queryId);
    var best = '0.0';
    for (var i = 0; i < rows.length; i++) {
      if (compareVersionNumbers(rows[i].VersionNumber, best) > 0) best = String(rows[i].VersionNumber);
    }
    return best === '0.0' ? '1.0' : best;
  }

  function countFor(queryId) {
    return SheetDB.filterBy(SHEETS.VERSIONS, 'QueryID', queryId).length;
  }

  /** Timeline, newest first. SQL bodies are NOT included. */
  function listFor(ctx, queryId) {
    if (!Auth.can(ctx, 'VIEW_VERSION')) {
      Log.denied(ctx, 'VIEW_VERSION', queryId);
      return Utils.err('You do not have permission to view version history.', 'FORBIDDEN');
    }
    var query = Queries.findRow(queryId);
    if (!query) return Utils.err('That query could not be found.', 'NOT_FOUND');

    var rows = SheetDB.filterBy(SHEETS.VERSIONS, 'QueryID', queryId).map(function (r) {
      return {
        versionId: r.VersionID,
        queryId: r.QueryID,
        version: String(r.VersionNumber),
        description: r.Description,
        changedBy: r.ChangedBy,
        changedByEmail: r.ChangedByEmail,
        changedAt: r.ChangedAt,
        summary: r.ChangeSummary,
        lines: String(r.SQLCode || '').split('\n').length,
        chars: String(r.SQLCode || '').length,
        isCurrent: String(r.VersionNumber) === String(query.Version || '1.0')
      };
    });

    rows.sort(function (a, b) { return compareVersionNumbers(b.version, a.version); });
    return Utils.ok({
      queryId: queryId,
      queryName: query.QueryName,
      currentVersion: String(query.Version || '1.0'),
      canRestore: Auth.can(ctx, 'RESTORE_VERSION') && Auth.canEditQuery(ctx, query),
      versions: rows
    });
  }

  function findVersion(versionId) {
    return SheetDB.findBy(SHEETS.VERSIONS, 'VersionID', versionId);
  }

  /** One version, including its SQL body. */
  function getVersion(ctx, versionId) {
    if (!Auth.can(ctx, 'VIEW_VERSION')) {
      return Utils.err('You do not have permission to view version history.', 'FORBIDDEN');
    }
    var v = findVersion(versionId);
    if (!v) return Utils.err('That version could not be found.', 'NOT_FOUND');

    Log.write(ctx, 'VIEW_VERSION', 'Versions', v.QueryID, 'Viewed v' + v.VersionNumber);
    return Utils.ok({
      versionId: v.VersionID,
      queryId: v.QueryID,
      version: String(v.VersionNumber),
      sql: v.SQLCode || '',
      description: v.Description,
      changedBy: v.ChangedBy,
      changedAt: v.ChangedAt,
      summary: v.ChangeSummary
    });
  }

  /**
   * Two versions side by side, plus a line level diff computed server side.
   * Pass versionId 'CURRENT' to compare against the live query.
   */
  function compare(ctx, queryId, leftId, rightId) {
    if (!Auth.can(ctx, 'VIEW_VERSION')) {
      return Utils.err('You do not have permission to view version history.', 'FORBIDDEN');
    }
    var query = Queries.findRow(queryId);
    if (!query) return Utils.err('That query could not be found.', 'NOT_FOUND');

    function resolve(id) {
      if (id === 'CURRENT' || !id) {
        return {
          version: String(query.Version || '1.0'),
          sql: query.SQLCode || '',
          changedBy: query.UpdatedBy,
          changedAt: query.UpdatedAt,
          summary: 'Current live version'
        };
      }
      var v = findVersion(id);
      if (!v) return null;
      return {
        version: String(v.VersionNumber),
        sql: v.SQLCode || '',
        changedBy: v.ChangedBy,
        changedAt: v.ChangedAt,
        summary: v.ChangeSummary
      };
    }

    var left = resolve(leftId);
    var right = resolve(rightId);
    if (!left || !right) return Utils.err('One of the versions could not be found.', 'NOT_FOUND');

    return Utils.ok({
      queryId: queryId,
      queryName: query.QueryName,
      left: left,
      right: right,
      diff: diffLines(left.sql, right.sql)
    });
  }

  /**
   * Longest common subsequence line diff.
   * Returns [{ type: 'same'|'add'|'del', leftNo, rightNo, text }]
   */
  function diffLines(a, b) {
    var A = String(a || '').split('\n');
    var B = String(b || '').split('\n');

    // Guard rail: LCS is O(n*m). Fall back to a coarse diff on huge inputs.
    if (A.length * B.length > 1500000) {
      var coarse = [];
      var max = Math.max(A.length, B.length);
      for (var i = 0; i < max; i++) {
        var la = A[i], lb = B[i];
        if (la === lb) coarse.push({ type: 'same', leftNo: i + 1, rightNo: i + 1, text: la });
        else {
          if (la !== undefined) coarse.push({ type: 'del', leftNo: i + 1, rightNo: null, text: la });
          if (lb !== undefined) coarse.push({ type: 'add', leftNo: null, rightNo: i + 1, text: lb });
        }
      }
      return coarse;
    }

    var n = A.length, m = B.length;
    var dp = [];
    for (var x = 0; x <= n; x++) dp.push(new Array(m + 1).fill(0));
    for (var i2 = n - 1; i2 >= 0; i2--) {
      for (var j2 = m - 1; j2 >= 0; j2--) {
        dp[i2][j2] = (A[i2] === B[j2]) ? dp[i2 + 1][j2 + 1] + 1 : Math.max(dp[i2 + 1][j2], dp[i2][j2 + 1]);
      }
    }

    var out = [], i3 = 0, j3 = 0;
    while (i3 < n && j3 < m) {
      if (A[i3] === B[j3]) {
        out.push({ type: 'same', leftNo: i3 + 1, rightNo: j3 + 1, text: A[i3] });
        i3++; j3++;
      } else if (dp[i3 + 1][j3] >= dp[i3][j3 + 1]) {
        out.push({ type: 'del', leftNo: i3 + 1, rightNo: null, text: A[i3] });
        i3++;
      } else {
        out.push({ type: 'add', leftNo: null, rightNo: j3 + 1, text: B[j3] });
        j3++;
      }
    }
    while (i3 < n) { out.push({ type: 'del', leftNo: i3 + 1, rightNo: null, text: A[i3] }); i3++; }
    while (j3 < m) { out.push({ type: 'add', leftNo: null, rightNo: j3 + 1, text: B[j3] }); j3++; }
    return out;
  }

  /**
   * Restore an older version.
   * The current body is NOT destroyed — a NEW, higher version is created
   * carrying the restored SQL.
   */
  function restore(ctx, queryId, versionId) {
    var query = Queries.findRow(queryId);
    if (!query) return Utils.err('That query could not be found.', 'NOT_FOUND');
    if (!Auth.can(ctx, 'RESTORE_VERSION') || !Auth.canEditQuery(ctx, query)) {
      Log.denied(ctx, 'RESTORE_VERSION', queryId);
      return Utils.err('You do not have permission to restore versions of this query.', 'FORBIDDEN');
    }
    var v = findVersion(versionId);
    if (!v || v.QueryID !== queryId) return Utils.err('That version could not be found.', 'NOT_FOUND');

    return SheetDB.withLock(function () {
      var fresh = Queries.findRow(queryId);
      ensureBaseline(ctx, fresh);

      var next = bump(highest(queryId), 'major');
      fresh.SQLCode = v.SQLCode;
      fresh.Version = next;
      fresh.UpdatedBy = ctx.name;
      fresh.UpdatedByEmail = ctx.email;
      fresh.UpdatedAt = Utils.iso(Utils.now());
      SheetDB.update(SHEETS.QUERIES, fresh);

      if (fresh.DriveFileID) DriveService.updateSqlFile(fresh.DriveFileID, fresh.SQLCode);

      snapshot(ctx, fresh, next, 'Restored from v' + v.VersionNumber);
      Log.write(ctx, 'RESTORE_VERSION', 'Versions', queryId,
        'Restored v' + v.VersionNumber + ' as v' + next);

      return Utils.ok({ queryId: queryId, version: next },
        'Version ' + v.VersionNumber + ' restored as v' + next + '.');
    });
  }

  return {
    snapshot: snapshot,
    ensureBaseline: ensureBaseline,
    bump: bump,
    highest: highest,
    countFor: countFor,
    listFor: listFor,
    getVersion: getVersion,
    compare: compare,
    diffLines: diffLines,
    restore: restore,
    compareVersionNumbers: compareVersionNumbers
  };
})();


/* ========================================================================== *
 * SECTION 07 — Categories.gs
 * Category master data.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Categories.gs
 * ----------------------------------------------------------------------------
 * Category master data. Categories are never hard deleted while queries still
 * reference them — they are archived instead, so history stays readable.
 * ============================================================================
 */

var Categories = (function () {

  function list(ctx, includeInactive) {
    var counts = {};
    Queries.index().forEach(function (q) {
      if (q.isDeleted) return;
      counts[q.categoryId] = (counts[q.categoryId] || 0) + 1;
    });

    return SheetDB.readAll(SHEETS.CATEGORIES)
      .filter(function (c) { return includeInactive || String(c.Status) === 'Active'; })
      .map(function (c) {
        return {
          categoryId: c.CategoryID,
          name: c.CategoryName,
          description: c.Description,
          status: c.Status,
          createdBy: c.CreatedBy,
          createdAt: c.CreatedAt,
          updatedAt: c.UpdatedAt,
          queryCount: counts[c.CategoryID] || 0
        };
      })
      .sort(function (a, b) { return a.name > b.name ? 1 : -1; });
  }

  function nameTaken(name, exceptId) {
    var target = String(name).toLowerCase();
    return SheetDB.readAll(SHEETS.CATEGORIES).some(function (c) {
      return String(c.CategoryName).toLowerCase() === target && c.CategoryID !== exceptId;
    });
  }

  function create(ctx, data) {
    if (!Auth.can(ctx, 'MANAGE_CATEGORIES')) {
      Log.denied(ctx, 'MANAGE_CATEGORIES');
      return Utils.err('You do not have permission to manage categories.', 'FORBIDDEN');
    }
    var name = Utils.text(data.name, 80);
    if (!name) return Utils.err('Category name is required.', 'VALIDATION');
    if (nameTaken(name)) return Utils.err('A category with that name already exists.', 'DUPLICATE');

    var stamp = Utils.iso(Utils.now());
    var row = {
      CategoryID: SheetDB.nextSequence('CATEGORY', 'CAT-', 3),
      CategoryName: name,
      Description: Utils.text(data.description, 500),
      Status: 'Active',
      CreatedBy: ctx.name,
      CreatedAt: stamp,
      UpdatedAt: stamp
    };
    SheetDB.insert(SHEETS.CATEGORIES, row);
    delete __MEMO__.__catMap;
    Cache.remove('idx::queries');

    Log.write(ctx, 'CREATE_CATEGORY', 'Categories', '', 'Created category ' + name);
    return Utils.ok({ categoryId: row.CategoryID, name: name }, 'Category created.');
  }

  function update(ctx, categoryId, data) {
    if (!Auth.can(ctx, 'MANAGE_CATEGORIES')) {
      Log.denied(ctx, 'MANAGE_CATEGORIES');
      return Utils.err('You do not have permission to manage categories.', 'FORBIDDEN');
    }
    var row = SheetDB.findBy(SHEETS.CATEGORIES, 'CategoryID', Utils.text(categoryId, 40));
    if (!row) return Utils.err('That category could not be found.', 'NOT_FOUND');

    var name = Utils.text(data.name, 80);
    if (!name) return Utils.err('Category name is required.', 'VALIDATION');
    if (nameTaken(name, row.CategoryID)) return Utils.err('A category with that name already exists.', 'DUPLICATE');

    var status = Utils.text(data.status, 20) || row.Status;
    if (['Active', 'Inactive'].indexOf(status) === -1) status = 'Active';

    row.CategoryName = name;
    row.Description = Utils.text(data.description, 500);
    row.Status = status;
    row.UpdatedAt = Utils.iso(Utils.now());
    SheetDB.update(SHEETS.CATEGORIES, row);
    delete __MEMO__.__catMap;
    Cache.remove('idx::queries');

    Log.write(ctx, 'UPDATE_CATEGORY', 'Categories', '', 'Updated category ' + name);
    return Utils.ok({ categoryId: row.CategoryID }, 'Category updated.');
  }

  /** Archive, or hard delete when nothing references it. */
  function remove(ctx, categoryId) {
    if (!Auth.can(ctx, 'MANAGE_CATEGORIES')) {
      Log.denied(ctx, 'MANAGE_CATEGORIES');
      return Utils.err('You do not have permission to manage categories.', 'FORBIDDEN');
    }
    var row = SheetDB.findBy(SHEETS.CATEGORIES, 'CategoryID', Utils.text(categoryId, 40));
    if (!row) return Utils.err('That category could not be found.', 'NOT_FOUND');

    var inUse = Queries.index().filter(function (q) { return q.categoryId === row.CategoryID; }).length;
    if (inUse > 0) {
      row.Status = 'Inactive';
      row.UpdatedAt = Utils.iso(Utils.now());
      SheetDB.update(SHEETS.CATEGORIES, row);
      delete __MEMO__.__catMap;
      Log.write(ctx, 'DELETE_CATEGORY', 'Categories', '', 'Archived category ' + row.CategoryName + ' (' + inUse + ' queries)');
      return Utils.ok(null, 'Category archived — ' + inUse + ' quer' + (inUse === 1 ? 'y' : 'ies') + ' still use it.');
    }

    SheetDB.deleteRows(SHEETS.CATEGORIES, [row._row]);
    delete __MEMO__.__catMap;
    Log.write(ctx, 'DELETE_CATEGORY', 'Categories', '', 'Deleted category ' + row.CategoryName);
    return Utils.ok(null, 'Category deleted.');
  }

  return { list: list, create: create, update: update, remove: remove };
})();


/* ========================================================================== *
 * SECTION 08 — Databases.gs
 * Database labels. Never credentials.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Databases.gs
 * ----------------------------------------------------------------------------
 * Database master data — a LABEL for where a query is meant to run.
 *
 * IMPORTANT: this application never connects to a database and deliberately
 * stores NO host, port, username or password. It is a query notebook, not an
 * execution engine. If you later add a connector, put its credentials in
 * Script Properties or Secret Manager — never in this sheet.
 * ============================================================================
 */

var Databases = (function () {

  var ENVIRONMENTS = ['Production', 'Test', 'Development', 'Staging', 'Other'];

  function list(ctx, includeInactive) {
    var counts = {};
    Queries.index().forEach(function (q) {
      if (q.isDeleted) return;
      counts[q.databaseId] = (counts[q.databaseId] || 0) + 1;
    });

    return SheetDB.readAll(SHEETS.DATABASES)
      .filter(function (d) { return includeInactive || String(d.Status) === 'Active'; })
      .map(function (d) {
        return {
          databaseId: d.DatabaseID,
          name: d.DatabaseName,
          description: d.Description,
          environment: d.Environment,
          status: d.Status,
          createdBy: d.CreatedBy,
          createdAt: d.CreatedAt,
          label: d.DatabaseName + (d.Environment ? ' — ' + d.Environment : ''),
          queryCount: counts[d.DatabaseID] || 0
        };
      })
      .sort(function (a, b) { return a.label > b.label ? 1 : -1; });
  }

  function duplicateExists(name, env, exceptId) {
    var n = String(name).toLowerCase(), e = String(env).toLowerCase();
    return SheetDB.readAll(SHEETS.DATABASES).some(function (d) {
      return String(d.DatabaseName).toLowerCase() === n
        && String(d.Environment).toLowerCase() === e
        && d.DatabaseID !== exceptId;
    });
  }

  function validate_(data) {
    var name = Utils.text(data.name, 80);
    var env = Utils.text(data.environment, 30) || 'Production';
    if (!name) return { error: 'Database name is required.' };
    if (ENVIRONMENTS.indexOf(env) === -1) return { error: 'Environment must be one of: ' + ENVIRONMENTS.join(', ') + '.' };

    // Refuse anything that looks like a credential.
    var blob = (name + ' ' + Utils.text(data.description, 500)).toLowerCase();
    if (/password\s*[:=]|pwd\s*[:=]|secret\s*[:=]|api[_ -]?key\s*[:=]/.test(blob)) {
      return { error: 'Do not store credentials here. Database entries are labels only.' };
    }
    return { name: name, environment: env, description: Utils.text(data.description, 500) };
  }

  function create(ctx, data) {
    if (!Auth.can(ctx, 'MANAGE_DATABASES')) {
      Log.denied(ctx, 'MANAGE_DATABASES');
      return Utils.err('You do not have permission to manage databases.', 'FORBIDDEN');
    }
    var v = validate_(data);
    if (v.error) return Utils.err(v.error, 'VALIDATION');
    if (duplicateExists(v.name, v.environment)) {
      return Utils.err('That database and environment combination already exists.', 'DUPLICATE');
    }

    var row = {
      DatabaseID: SheetDB.nextSequence('DATABASE', 'DB-', 3),
      DatabaseName: v.name,
      Description: v.description,
      Environment: v.environment,
      Status: 'Active',
      CreatedBy: ctx.name,
      CreatedAt: Utils.iso(Utils.now())
    };
    SheetDB.insert(SHEETS.DATABASES, row);
    delete __MEMO__.__dbMap;
    Cache.remove('idx::queries');

    Log.write(ctx, 'CREATE_DATABASE', 'Databases', '', 'Created database ' + v.name + ' (' + v.environment + ')');
    return Utils.ok({ databaseId: row.DatabaseID }, 'Database added.');
  }

  function update(ctx, databaseId, data) {
    if (!Auth.can(ctx, 'MANAGE_DATABASES')) {
      Log.denied(ctx, 'MANAGE_DATABASES');
      return Utils.err('You do not have permission to manage databases.', 'FORBIDDEN');
    }
    var row = SheetDB.findBy(SHEETS.DATABASES, 'DatabaseID', Utils.text(databaseId, 40));
    if (!row) return Utils.err('That database could not be found.', 'NOT_FOUND');

    var v = validate_(data);
    if (v.error) return Utils.err(v.error, 'VALIDATION');
    if (duplicateExists(v.name, v.environment, row.DatabaseID)) {
      return Utils.err('That database and environment combination already exists.', 'DUPLICATE');
    }

    var status = Utils.text(data.status, 20) || row.Status;
    if (['Active', 'Inactive'].indexOf(status) === -1) status = 'Active';

    row.DatabaseName = v.name;
    row.Description = v.description;
    row.Environment = v.environment;
    row.Status = status;
    SheetDB.update(SHEETS.DATABASES, row);
    delete __MEMO__.__dbMap;
    Cache.remove('idx::queries');

    Log.write(ctx, 'UPDATE_DATABASE', 'Databases', '', 'Updated database ' + v.name);
    return Utils.ok({ databaseId: row.DatabaseID }, 'Database updated.');
  }

  function remove(ctx, databaseId) {
    if (!Auth.can(ctx, 'MANAGE_DATABASES')) {
      Log.denied(ctx, 'MANAGE_DATABASES');
      return Utils.err('You do not have permission to manage databases.', 'FORBIDDEN');
    }
    var row = SheetDB.findBy(SHEETS.DATABASES, 'DatabaseID', Utils.text(databaseId, 40));
    if (!row) return Utils.err('That database could not be found.', 'NOT_FOUND');

    var inUse = Queries.index().filter(function (q) { return q.databaseId === row.DatabaseID; }).length;
    if (inUse > 0) {
      row.Status = 'Inactive';
      SheetDB.update(SHEETS.DATABASES, row);
      delete __MEMO__.__dbMap;
      Log.write(ctx, 'DELETE_DATABASE', 'Databases', '', 'Archived database ' + row.DatabaseName);
      return Utils.ok(null, 'Database archived — ' + inUse + ' quer' + (inUse === 1 ? 'y' : 'ies') + ' still use it.');
    }

    SheetDB.deleteRows(SHEETS.DATABASES, [row._row]);
    delete __MEMO__.__dbMap;
    Log.write(ctx, 'DELETE_DATABASE', 'Databases', '', 'Deleted database ' + row.DatabaseName);
    return Utils.ok(null, 'Database deleted.');
  }

  return { list: list, create: create, update: update, remove: remove, ENVIRONMENTS: ENVIRONMENTS };
})();


/* ========================================================================== *
 * SECTION 09 — Users.gs
 * Users, roles and the permission matrix.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Users.gs
 * ----------------------------------------------------------------------------
 * User and role administration.
 *
 * Guard rails enforced here:
 *   - the last remaining active Admin can never be demoted or deactivated
 *   - nobody can change their own role
 *   - password hashes and salts NEVER leave the server
 * ============================================================================
 */

var Users = (function () {

  function toPublic(u, roleNames) {
    return {
      userId: u.UserID,
      name: u.Name,
      email: Utils.normEmail(u.Email),
      roleId: u.RoleID,
      roleName: roleNames[u.RoleID] || u.RoleID,
      department: u.Department || '',
      status: u.Status || 'Active',
      createdAt: u.CreatedAt,
      lastLogin: u.LastLogin,
      lastLogout: u.LastLogout,
      hasActiveSession: !!u.ActiveSessionID,
      hasAppPassword: !!u.PasswordHash,
      initials: (String(u.Name || u.Email).charAt(0) || '?').toUpperCase()
    };
  }

  function roleNameMap() {
    var map = {};
    SheetDB.readAll(SHEETS.ROLES).forEach(function (r) { map[r.RoleID] = r.RoleName; });
    return map;
  }

  function activeAdminCount(exceptUserId) {
    return SheetDB.readAll(SHEETS.USERS).filter(function (u) {
      return u.RoleID === 'ROLE-ADMIN'
        && String(u.Status).toUpperCase() === 'ACTIVE'
        && u.UserID !== exceptUserId;
    }).length;
  }

  function list(ctx, filters) {
    if (!Auth.can(ctx, 'MANAGE_USERS')) {
      Log.denied(ctx, 'MANAGE_USERS');
      return Utils.err('You do not have permission to view users.', 'FORBIDDEN');
    }
    var f = filters || {};
    var names = roleNameMap();
    var search = Utils.text(f.search, 100).toLowerCase();
    var roleId = Utils.text(f.roleId, 40);
    var status = Utils.text(f.status, 20);

    var rows = SheetDB.readAll(SHEETS.USERS)
      .map(function (u) { return toPublic(u, names); })
      .filter(function (u) {
        if (roleId && u.roleId !== roleId) return false;
        if (status && String(u.status).toLowerCase() !== status.toLowerCase()) return false;
        if (search) {
          var hay = (u.name + ' ' + u.email + ' ' + u.department + ' ' + u.roleName).toLowerCase();
          if (hay.indexOf(search) === -1) return false;
        }
        return true;
      });

    rows.sort(function (a, b) { return a.name > b.name ? 1 : -1; });

    var page = Utils.clampInt(f.page, 1, 10000, 1);
    var pageSize = Utils.clampInt(f.pageSize, 5, 200, 25);
    var total = rows.length;

    return Utils.ok({
      rows: rows.slice((page - 1) * pageSize, page * pageSize),
      total: total,
      page: page,
      pageSize: pageSize,
      totalPages: Math.max(1, Math.ceil(total / pageSize)),
      counts: {
        total: total,
        active: rows.filter(function (u) { return String(u.status).toUpperCase() === 'ACTIVE'; }).length,
        admins: rows.filter(function (u) { return u.roleId === 'ROLE-ADMIN'; }).length
      }
    });
  }

  /** Internal helper used by self registration. Never exposed to the client. */
  function provision(email, name, roleId) {
    var stamp = Utils.iso(Utils.now());
    var row = {
      UserID: SheetDB.nextSequence('USER', 'USR-', 4),
      Name: Utils.text(name, 120) || email.split('@')[0],
      Email: Utils.normEmail(email),
      RoleID: roleId || 'ROLE-VIEWER',
      Department: '',
      Status: 'Active',
      CreatedAt: stamp,
      LastLogin: '',
      LastLogout: '',
      ActiveSessionID: '',
      PasswordHash: '',
      PasswordSalt: '',
      MustChangePassword: 'FALSE',
      FailedAttempts: 0,
      LockedUntil: ''
    };
    SheetDB.insert(SHEETS.USERS, row);
    return row;
  }

  function create(ctx, data) {
    if (!Auth.can(ctx, 'MANAGE_USERS')) {
      Log.denied(ctx, 'MANAGE_USERS');
      return Utils.err('You do not have permission to create users.', 'FORBIDDEN');
    }
    var email = Utils.normEmail(data.email);
    var name = Utils.text(data.name, 120);
    var roleId = Utils.text(data.roleId, 40) || 'ROLE-VIEWER';

    if (!name) return Utils.err('Name is required.', 'VALIDATION');
    if (!Utils.isEmail(email)) return Utils.err('Enter a valid email address.', 'VALIDATION');
    if (Auth.userByEmail(email)) return Utils.err('A user with that email already exists.', 'DUPLICATE');
    if (!SheetDB.findBy(SHEETS.ROLES, 'RoleID', roleId)) return Utils.err('That role does not exist.', 'VALIDATION');

    var row = provision(email, name, roleId);
    row.Department = Utils.text(data.department, 80);

    // Optional application password (only needed when Google SSO is unavailable).
    var tempPassword = '';
    if (Utils.bool(data.setAppPassword)) {
      tempPassword = Utils.token(14);
      row.PasswordSalt = Utils.newSalt();
      row.PasswordHash = Utils.hashPassword(tempPassword, row.PasswordSalt);
      row.MustChangePassword = 'TRUE';
    }
    SheetDB.update(SHEETS.USERS, row);

    Log.write(ctx, 'CREATE_USER', 'Users', '', 'Created user ' + email + ' as ' + roleId);
    Notifications.userInvited(ctx, row, tempPassword);

    return Utils.ok({
      userId: row.UserID,
      email: email,
      tempPassword: tempPassword          // shown once to the admin, never stored in clear
    }, 'User created.');
  }

  function update(ctx, userId, data) {
    if (!Auth.can(ctx, 'MANAGE_USERS')) {
      Log.denied(ctx, 'MANAGE_USERS');
      return Utils.err('You do not have permission to edit users.', 'FORBIDDEN');
    }
    var row = SheetDB.findBy(SHEETS.USERS, 'UserID', Utils.text(userId, 40));
    if (!row) return Utils.err('That user could not be found.', 'NOT_FOUND');

    var newRole = Utils.text(data.roleId, 40) || row.RoleID;
    var newStatus = Utils.text(data.status, 20) || row.Status;
    if (['Active', 'Inactive', 'Suspended'].indexOf(newStatus) === -1) newStatus = 'Active';

    if (row.UserID === ctx.userId && newRole !== row.RoleID) {
      return Utils.err('You cannot change your own role.', 'FORBIDDEN');
    }
    if (!SheetDB.findBy(SHEETS.ROLES, 'RoleID', newRole)) {
      return Utils.err('That role does not exist.', 'VALIDATION');
    }

    var losingAdmin = (row.RoleID === 'ROLE-ADMIN')
      && (newRole !== 'ROLE-ADMIN' || String(newStatus).toUpperCase() !== 'ACTIVE');
    if (losingAdmin && activeAdminCount(row.UserID) === 0) {
      return Utils.err('This is the last active administrator. Promote somebody else first.', 'LAST_ADMIN');
    }

    var name = Utils.text(data.name, 120);
    if (name) row.Name = name;
    if (data.department !== undefined) row.Department = Utils.text(data.department, 80);
    row.RoleID = newRole;
    row.Status = newStatus;

    // Deactivating a user immediately kills their session.
    if (String(newStatus).toUpperCase() !== 'ACTIVE' && row.ActiveSessionID) {
      var s = Auth.sessionById(row.ActiveSessionID);
      if (s) Auth.endSession(s, 'REVOKED');
      row.ActiveSessionID = '';
    }

    SheetDB.update(SHEETS.USERS, row);
    Log.write(ctx, 'UPDATE_USER', 'Users', '', 'Updated ' + row.Email + ' -> ' + newRole + ' / ' + newStatus);

    if (data.roleId && data.roleId !== newRole) Notifications.permissionChanged(ctx, row);
    return Utils.ok({ userId: row.UserID }, 'User updated.');
  }

  /** Deactivate. Users are never physically removed — the audit trail needs them. */
  function deactivate(ctx, userId) {
    if (!Auth.can(ctx, 'MANAGE_USERS')) {
      Log.denied(ctx, 'MANAGE_USERS');
      return Utils.err('You do not have permission to remove users.', 'FORBIDDEN');
    }
    var row = SheetDB.findBy(SHEETS.USERS, 'UserID', Utils.text(userId, 40));
    if (!row) return Utils.err('That user could not be found.', 'NOT_FOUND');
    if (row.UserID === ctx.userId) return Utils.err('You cannot deactivate your own account.', 'FORBIDDEN');
    if (row.RoleID === 'ROLE-ADMIN' && activeAdminCount(row.UserID) === 0) {
      return Utils.err('This is the last active administrator.', 'LAST_ADMIN');
    }

    row.Status = 'Inactive';
    if (row.ActiveSessionID) {
      var s = Auth.sessionById(row.ActiveSessionID);
      if (s) Auth.endSession(s, 'REVOKED');
      row.ActiveSessionID = '';
    }
    SheetDB.update(SHEETS.USERS, row);
    Log.write(ctx, 'DELETE_USER', 'Users', '', 'Deactivated ' + row.Email);
    return Utils.ok(null, 'User deactivated.');
  }

  /** Force sign-out. */
  function resetSession(ctx, userId) {
    if (!Auth.can(ctx, 'MANAGE_USERS')) {
      Log.denied(ctx, 'MANAGE_USERS');
      return Utils.err('You do not have permission to reset sessions.', 'FORBIDDEN');
    }
    var row = SheetDB.findBy(SHEETS.USERS, 'UserID', Utils.text(userId, 40));
    if (!row) return Utils.err('That user could not be found.', 'NOT_FOUND');

    if (row.ActiveSessionID) {
      var s = Auth.sessionById(row.ActiveSessionID);
      if (s) Auth.endSession(s, 'REVOKED');
    }
    row.ActiveSessionID = '';
    SheetDB.update(SHEETS.USERS, row);
    Log.write(ctx, 'RESET_SESSION', 'Users', '', 'Reset session for ' + row.Email);
    return Utils.ok(null, 'Session reset. The user will be asked to sign in again.');
  }

  /** Issue a new temporary application password. */
  function resetPassword(ctx, userId) {
    if (!Auth.can(ctx, 'MANAGE_USERS')) {
      Log.denied(ctx, 'MANAGE_USERS');
      return Utils.err('You do not have permission to reset passwords.', 'FORBIDDEN');
    }
    var row = SheetDB.findBy(SHEETS.USERS, 'UserID', Utils.text(userId, 40));
    if (!row) return Utils.err('That user could not be found.', 'NOT_FOUND');

    var temp = Utils.token(14);
    row.PasswordSalt = Utils.newSalt();
    row.PasswordHash = Utils.hashPassword(temp, row.PasswordSalt);
    row.MustChangePassword = 'TRUE';
    row.FailedAttempts = 0;
    row.LockedUntil = '';
    SheetDB.update(SHEETS.USERS, row);

    Log.write(ctx, 'UPDATE_USER', 'Users', '', 'Reset application password for ' + row.Email);
    Notifications.passwordReset(ctx, row, temp);
    return Utils.ok({ tempPassword: temp }, 'Temporary password generated.');
  }

  /* ---------------------------------------------------------------- *
   * Roles & permissions
   * ---------------------------------------------------------------- */

  function roles(ctx) {
    var map = Auth.rolePermissionMap();
    var counts = {};
    SheetDB.readAll(SHEETS.USERS).forEach(function (u) {
      counts[u.RoleID] = (counts[u.RoleID] || 0) + 1;
    });

    return SheetDB.readAll(SHEETS.ROLES).map(function (r) {
      var granted = [];
      var rp = map[r.RoleID] || {};
      for (var p in rp) if (rp[p]) granted.push(p);
      return {
        roleId: r.RoleID,
        name: r.RoleName,
        description: r.Description,
        isSystem: Utils.bool(r.IsSystem),
        userCount: counts[r.RoleID] || 0,
        permissions: granted
      };
    });
  }

  function permissionMatrix(ctx) {
    if (!Auth.can(ctx, 'MANAGE_ROLES') && !Auth.can(ctx, 'MANAGE_USERS')) {
      return Utils.err('You do not have permission to view the permission matrix.', 'FORBIDDEN');
    }
    return Utils.ok({
      permissions: PERMISSIONS,
      roles: roles(ctx),
      editable: Auth.can(ctx, 'MANAGE_ROLES')
    });
  }

  /**
   * Replace the permission grid.
   * changes = [{ roleId, permission, allowed }]
   */
  function updatePermissions(ctx, changes) {
    if (!Auth.can(ctx, 'MANAGE_ROLES')) {
      Log.denied(ctx, 'MANAGE_ROLES');
      return Utils.err('You do not have permission to change roles.', 'FORBIDDEN');
    }
    if (!Array.isArray(changes) || !changes.length) {
      return Utils.err('No changes were supplied.', 'VALIDATION');
    }

    // Never allow the Admin role to lose the ability to manage roles/users:
    // that would lock everybody out of administration permanently.
    for (var g = 0; g < changes.length; g++) {
      var chg = changes[g];
      if (chg.roleId === 'ROLE-ADMIN'
        && ['MANAGE_ROLES', 'MANAGE_USERS'].indexOf(chg.permission) !== -1
        && !Utils.bool(chg.allowed)) {
        return Utils.err('The Admin role must keep MANAGE_ROLES and MANAGE_USERS.', 'PROTECTED');
      }
    }

    var rows = SheetDB.readAll(SHEETS.PERMISSIONS);
    var byKey = {};
    rows.forEach(function (r) { byKey[r.RoleID + '::' + r.Permission] = r; });

    var toUpdate = [], toInsert = [], applied = 0;

    for (var i = 0; i < changes.length; i++) {
      var c = changes[i];
      var roleId = Utils.text(c.roleId, 40);
      var perm = Utils.text(c.permission, 60);
      if (!roleId || PERMISSIONS.indexOf(perm) === -1) continue;
      if (!SheetDB.findBy(SHEETS.ROLES, 'RoleID', roleId)) continue;

      var allowed = Utils.bool(c.allowed) ? 'TRUE' : 'FALSE';
      var existing = byKey[roleId + '::' + perm];
      if (existing) {
        if (String(existing.Allowed).toUpperCase() !== allowed) {
          existing.Allowed = allowed;
          toUpdate.push(existing);
          applied++;
        }
      } else {
        toInsert.push({
          PermissionID: 'PRM-' + roleId.replace('ROLE-', '') + '-' + perm,
          RoleID: roleId,
          Permission: perm,
          Allowed: allowed
        });
        applied++;
      }
    }

    if (toUpdate.length) SheetDB.updateMany(SHEETS.PERMISSIONS, toUpdate);
    if (toInsert.length) SheetDB.insertMany(SHEETS.PERMISSIONS, toInsert);

    delete __MEMO__.__rolePerms;
    Cache.remove('rolePerms');

    Log.write(ctx, 'CHANGE_PERMISSION', 'Roles', '', applied + ' permission change(s) applied');
    return Utils.ok({ applied: applied }, applied + ' permission change(s) saved.');
  }

  function createRole(ctx, data) {
    if (!Auth.can(ctx, 'MANAGE_ROLES')) {
      Log.denied(ctx, 'MANAGE_ROLES');
      return Utils.err('You do not have permission to create roles.', 'FORBIDDEN');
    }
    var name = Utils.text(data.name, 60);
    if (!name) return Utils.err('Role name is required.', 'VALIDATION');

    var id = 'ROLE-' + name.toUpperCase().replace(/[^A-Z0-9]+/g, '-').replace(/^-|-$/g, '');
    if (SheetDB.findBy(SHEETS.ROLES, 'RoleID', id)) return Utils.err('A role with that name already exists.', 'DUPLICATE');

    SheetDB.insert(SHEETS.ROLES, {
      RoleID: id,
      RoleName: name,
      Description: Utils.text(data.description, 300),
      IsSystem: 'FALSE',
      CreatedAt: Utils.iso(Utils.now())
    });

    // Start from the Viewer baseline so a new role is never accidentally powerful.
    var base = DEFAULT_ROLE_PERMISSIONS['ROLE-VIEWER'];
    var rows = PERMISSIONS.map(function (p) {
      return {
        PermissionID: 'PRM-' + id.replace('ROLE-', '') + '-' + p,
        RoleID: id,
        Permission: p,
        Allowed: base.indexOf(p) !== -1 ? 'TRUE' : 'FALSE'
      };
    });
    SheetDB.insertMany(SHEETS.PERMISSIONS, rows);

    delete __MEMO__.__rolePerms;
    Cache.remove('rolePerms');
    Log.write(ctx, 'CHANGE_PERMISSION', 'Roles', '', 'Created role ' + name);
    return Utils.ok({ roleId: id }, 'Role created with Viewer level permissions.');
  }

  function deleteRole(ctx, roleId) {
    if (!Auth.can(ctx, 'MANAGE_ROLES')) {
      Log.denied(ctx, 'MANAGE_ROLES');
      return Utils.err('You do not have permission to delete roles.', 'FORBIDDEN');
    }
    var role = SheetDB.findBy(SHEETS.ROLES, 'RoleID', Utils.text(roleId, 40));
    if (!role) return Utils.err('That role could not be found.', 'NOT_FOUND');
    if (Utils.bool(role.IsSystem)) return Utils.err('Built in roles cannot be deleted.', 'PROTECTED');

    var inUse = SheetDB.filterBy(SHEETS.USERS, 'RoleID', role.RoleID).length;
    if (inUse) return Utils.err(inUse + ' user(s) still have this role. Reassign them first.', 'IN_USE');

    var permRows = SheetDB.filterBy(SHEETS.PERMISSIONS, 'RoleID', role.RoleID).map(function (r) { return r._row; });
    SheetDB.deleteRows(SHEETS.PERMISSIONS, permRows);
    SheetDB.deleteRows(SHEETS.ROLES, [role._row]);

    delete __MEMO__.__rolePerms;
    Cache.remove('rolePerms');
    Log.write(ctx, 'CHANGE_PERMISSION', 'Roles', '', 'Deleted role ' + role.RoleName);
    return Utils.ok(null, 'Role deleted.');
  }

  /** Active sessions view for the admin panel. */
  function sessions(ctx) {
    if (!Auth.can(ctx, 'MANAGE_USERS')) {
      return Utils.err('You do not have permission to view sessions.', 'FORBIDDEN');
    }
    var users = {};
    SheetDB.readAll(SHEETS.USERS).forEach(function (u) { users[u.UserID] = u; });

    var rows = SheetDB.readAll(SHEETS.SESSIONS)
      .filter(function (s) { return s.Status === 'ACTIVE'; })
      .map(function (s) {
        var u = users[s.UserID];
        return {
          sessionId: s.SessionID,
          userId: s.UserID,
          name: u ? u.Name : '(deleted user)',
          email: u ? u.Email : '',
          createdAt: s.CreatedAt,
          lastActivity: s.LastActivity,
          expiresAt: s.ExpiresAt
        };
      });
    Utils.sortBy(rows, 'lastActivity', 'desc');
    return Utils.ok(rows);
  }

  return {
    list: list,
    create: create,
    update: update,
    deactivate: deactivate,
    resetSession: resetSession,
    resetPassword: resetPassword,
    provision: provision,
    roles: roles,
    permissionMatrix: permissionMatrix,
    updatePermissions: updatePermissions,
    createRole: createRole,
    deleteRole: deleteRole,
    sessions: sessions,
    roleNameMap: roleNameMap
  };
})();


/* ========================================================================== *
 * SECTION 10 — Favorites.gs
 * Per-user favourites.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Favorites.gs
 * ----------------------------------------------------------------------------
 * Favourites are PER USER. There is deliberately no single global
 * "IsFavorite" flag on a query — with 100+ users one shared star would be
 * meaningless. The UserFavorites sheet is the only source of truth.
 * ============================================================================
 */

var Favorites = (function () {

  function forUser(userId) {
    return SheetDB.filterBy(SHEETS.FAVORITES, 'UserID', userId);
  }

  function idsForUser(userId) {
    var key = '__fav_' + userId;
    if (__MEMO__[key]) return __MEMO__[key];
    var ids = forUser(userId).map(function (r) { return r.QueryID; });
    __MEMO__[key] = ids;
    return ids;
  }

  function isFavorite(userId, queryId) {
    return idsForUser(userId).indexOf(queryId) !== -1;
  }

  function add(ctx, queryId) {
    var query = Queries.findRow(queryId);
    if (!query) return Utils.err('That query could not be found.', 'NOT_FOUND');
    if (isFavorite(ctx.userId, queryId)) {
      return Utils.ok({ queryId: queryId, isFavorite: true }, 'Already in your favourites.');
    }

    SheetDB.insert(SHEETS.FAVORITES, {
      FavoriteID: 'FAV-' + Utils.token(20),
      UserID: ctx.userId,
      QueryID: queryId,
      CreatedAt: Utils.iso(Utils.now())
    });
    delete __MEMO__['__fav_' + ctx.userId];

    Log.write(ctx, 'FAVORITE_QUERY', 'Favorites', queryId, 'Added ' + query.QueryName + ' to favourites');
    return Utils.ok({ queryId: queryId, isFavorite: true }, 'Added to favourites.');
  }

  function remove(ctx, queryId) {
    var mine = forUser(ctx.userId).filter(function (r) { return r.QueryID === queryId; });
    if (!mine.length) {
      return Utils.ok({ queryId: queryId, isFavorite: false }, 'Not in your favourites.');
    }
    SheetDB.deleteRows(SHEETS.FAVORITES, mine.map(function (r) { return r._row; }));
    delete __MEMO__['__fav_' + ctx.userId];

    Log.write(ctx, 'UNFAVORITE_QUERY', 'Favorites', queryId, 'Removed from favourites');
    return Utils.ok({ queryId: queryId, isFavorite: false }, 'Removed from favourites.');
  }

  function toggle(ctx, queryId) {
    return isFavorite(ctx.userId, queryId) ? remove(ctx, queryId) : add(ctx, queryId);
  }

  return {
    forUser: forUser,
    idsForUser: idsForUser,
    isFavorite: isFavorite,
    add: add,
    remove: remove,
    toggle: toggle
  };
})();


/* ========================================================================== *
 * SECTION 11 — Sharing.gs
 * Query sharing with VIEW / EDIT grants.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Sharing.gs
 * ----------------------------------------------------------------------------
 * Share a query with a named person at VIEW or EDIT level, optionally with an
 * expiry date.
 *
 * SECURITY NOTE
 *   "Copy link" produces a deep link of the form  <webapp>?q=SQL-000001
 *   That link is NOT a capability — opening it still requires a signed-in
 *   account that passes the same permission checks as the rest of the app.
 *   Query ids are sequential and therefore guessable, which is exactly why
 *   access is never granted by the URL alone.
 * ============================================================================
 */

var Sharing = (function () {

  function activeShares() {
    if (__MEMO__.__shares) return __MEMO__.__shares;
    var now = Utils.now().getTime();
    var rows = SheetDB.readAll(SHEETS.SHARES).filter(function (r) {
      if (String(r.Status).toUpperCase() !== 'ACTIVE') return false;
      if (r.ExpiresAt) {
        var exp = new Date(r.ExpiresAt).getTime();
        if (!isNaN(exp) && exp < now) return false;
      }
      return true;
    });
    __MEMO__.__shares = rows;
    return rows;
  }

  /** Query ids shared TO this email address. */
  function idsSharedWith(email) {
    var mail = Utils.normEmail(email);
    return activeShares()
      .filter(function (r) { return Utils.normEmail(r.SharedTo) === mail; })
      .map(function (r) { return r.QueryID; });
  }

  /** Does an active share give this user EDIT on this query? */
  function grantsEdit(ctx, queryId) {
    var shares = activeShares();
    for (var i = 0; i < shares.length; i++) {
      if (shares[i].QueryID !== queryId) continue;
      if (Utils.normEmail(shares[i].SharedTo) !== ctx.email) continue;
      if (String(shares[i].Permission).toUpperCase() === 'EDIT') return true;
    }
    return false;
  }

  /** All shares on a query (visible to the owner, sharer and admins). */
  function forQuery(ctx, queryId) {
    var canSeeAll = Auth.can(ctx, 'MANAGE_USERS') || Auth.can(ctx, 'EDIT_ANY_QUERY');
    return SheetDB.filterBy(SHEETS.SHARES, 'QueryID', queryId)
      .filter(function (r) {
        if (canSeeAll) return true;
        return Utils.normEmail(r.SharedBy) === ctx.email || Utils.normEmail(r.SharedTo) === ctx.email;
      })
      .map(function (r) {
        return {
          shareId: r.ShareID,
          queryId: r.QueryID,
          sharedBy: r.SharedBy,
          sharedTo: r.SharedTo,
          permission: String(r.Permission || 'VIEW').toUpperCase(),
          createdAt: r.CreatedAt,
          expiresAt: r.ExpiresAt,
          status: r.Status
        };
      });
  }

  function share(ctx, data) {
    if (!Settings.getBool('ALLOW_SHARING')) {
      return Utils.err('Sharing is disabled by your administrator.', 'DISABLED');
    }
    if (!Auth.can(ctx, 'SHARE_QUERY')) {
      Log.denied(ctx, 'SHARE_QUERY', data && data.queryId);
      return Utils.err('You do not have permission to share queries.', 'FORBIDDEN');
    }

    var queryId = Utils.text(data.queryId, 40);
    var query = Queries.findRow(queryId);
    if (!query) return Utils.err('That query could not be found.', 'NOT_FOUND');

    var permission = String(Utils.text(data.permission, 10) || 'VIEW').toUpperCase();
    if (['VIEW', 'EDIT'].indexOf(permission) === -1) {
      return Utils.err('Permission must be VIEW or EDIT.', 'VALIDATION');
    }

    // Only somebody who can edit the query may hand out EDIT.
    if (permission === 'EDIT' && !Auth.canEditQuery(ctx, query)) {
      return Utils.err('You can only grant EDIT on a query you are able to edit.', 'FORBIDDEN');
    }

    var recipients = [];
    var raw = data.sharedTo;
    var list = Array.isArray(raw) ? raw : String(raw || '').split(/[,;\s]+/);
    for (var i = 0; i < list.length; i++) {
      var mail = Utils.normEmail(list[i]);
      if (!mail) continue;
      if (!Utils.isEmail(mail)) return Utils.err('"' + list[i] + '" is not a valid email address.', 'VALIDATION');
      if (mail === ctx.email) continue;                      // no self-shares
      if (recipients.indexOf(mail) === -1) recipients.push(mail);
      if (recipients.length > 25) return Utils.err('You can share with at most 25 people at a time.', 'VALIDATION');
    }
    if (!recipients.length) return Utils.err('Add at least one recipient.', 'VALIDATION');

    var expiresAt = '';
    if (data.expiresAt) {
      var exp = new Date(data.expiresAt);
      if (isNaN(exp.getTime())) return Utils.err('That expiry date is not valid.', 'VALIDATION');
      if (exp.getTime() < Utils.now().getTime()) return Utils.err('The expiry date is in the past.', 'VALIDATION');
      expiresAt = Utils.iso(exp);
    }

    var existing = SheetDB.filterBy(SHEETS.SHARES, 'QueryID', queryId);
    var stamp = Utils.iso(Utils.now());
    var toInsert = [], toUpdate = [], created = [];

    for (var r = 0; r < recipients.length; r++) {
      var mail2 = recipients[r];
      var prior = null;
      for (var e = 0; e < existing.length; e++) {
        if (Utils.normEmail(existing[e].SharedTo) === mail2) { prior = existing[e]; break; }
      }
      if (prior) {
        prior.Permission = permission;
        prior.ExpiresAt = expiresAt;
        prior.Status = 'ACTIVE';
        prior.SharedBy = ctx.email;
        prior.CreatedAt = stamp;
        toUpdate.push(prior);
      } else {
        toInsert.push({
          ShareID: 'SHR-' + Utils.token(20),
          QueryID: queryId,
          SharedBy: ctx.email,
          SharedTo: mail2,
          Permission: permission,
          CreatedAt: stamp,
          ExpiresAt: expiresAt,
          Status: 'ACTIVE'
        });
      }
      created.push(mail2);
    }

    if (toInsert.length) SheetDB.insertMany(SHEETS.SHARES, toInsert);
    if (toUpdate.length) SheetDB.updateMany(SHEETS.SHARES, toUpdate);
    delete __MEMO__.__shares;

    Log.write(ctx, 'SHARE_QUERY', 'Sharing', queryId,
      'Shared ' + query.QueryName + ' (' + permission + ') with ' + created.join(', '));

    Notifications.queryShared(ctx, query, created, permission);

    return Utils.ok({
      queryId: queryId,
      shares: forQuery(ctx, queryId)
    }, 'Shared with ' + created.length + ' ' + (created.length === 1 ? 'person' : 'people') + '.');
  }

  function removeShare(ctx, shareId) {
    var row = SheetDB.findBy(SHEETS.SHARES, 'ShareID', Utils.text(shareId, 40));
    if (!row) return Utils.err('That share could not be found.', 'NOT_FOUND');

    var isOwner = Utils.normEmail(row.SharedBy) === ctx.email;
    if (!isOwner && !Auth.can(ctx, 'MANAGE_USERS') && !Auth.can(ctx, 'EDIT_ANY_QUERY')) {
      Log.denied(ctx, 'SHARE_QUERY', row.QueryID);
      return Utils.err('You can only remove shares that you created.', 'FORBIDDEN');
    }

    row.Status = 'REVOKED';
    SheetDB.update(SHEETS.SHARES, row);
    delete __MEMO__.__shares;

    Log.write(ctx, 'UNSHARE_QUERY', 'Sharing', row.QueryID, 'Removed access for ' + row.SharedTo);
    return Utils.ok({ shareId: shareId }, 'Access removed.');
  }

  /** Everything shared with the signed in user, enriched for the list view. */
  function inbox(ctx) {
    var mail = ctx.email;
    var rows = activeShares().filter(function (r) { return Utils.normEmail(r.SharedTo) === mail; });
    var out = [];
    for (var i = 0; i < rows.length; i++) {
      var q = Queries.findRow(rows[i].QueryID);
      if (!q || Utils.bool(q.IsDeleted)) continue;
      var item = Queries.toListItem(q);
      item.sharedBy = rows[i].SharedBy;
      item.sharePermission = String(rows[i].Permission).toUpperCase();
      item.shareExpiresAt = rows[i].ExpiresAt;
      out.push(item);
    }
    Utils.sortBy(out, 'updatedAt', 'desc');
    return out;
  }

  return {
    idsSharedWith: idsSharedWith,
    grantsEdit: grantsEdit,
    forQuery: forQuery,
    share: share,
    removeShare: removeShare,
    inbox: inbox,
    activeShares: activeShares
  };
})();


/* ========================================================================== *
 * SECTION 12 — DriveService.gs
 * Drive .sql mirrors and file attachments.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — DriveService.gs
 * ----------------------------------------------------------------------------
 * Google Drive integration:
 *   SQL Query Notebook/
 *     ├── SQL Files     one .sql mirror per query (optional)
 *     ├── Attachments   supporting files uploaded against a query
 *     ├── Exports       CSV / ZIP exports
 *     └── Backups       spreadsheet snapshots
 *
 * Every write is wrapped in try/catch: Drive being unavailable must never
 * stop somebody saving a query.
 * ============================================================================
 */

var DriveService = (function () {

  function folder(propKey) {
    var id = getProp(propKey);
    if (!id) return null;
    try { return DriveApp.getFolderById(id); }
    catch (e) { Utils.logError(e, 'DriveService.folder ' + propKey); return null; }
  }

  function sqlFolder()        { return folder(PROP.SQL_FOLDER_ID); }
  function attachmentFolder() { return folder(PROP.ATTACHMENT_FOLDER_ID); }
  function exportFolder()     { return folder(PROP.EXPORT_FOLDER_ID); }
  function backupFolder()     { return folder(PROP.BACKUP_FOLDER_ID); }

  /** SQL-000001_Rider_Performance_KPI.sql */
  function sqlFileName(queryId, queryName) {
    var safe = String(queryName || 'query')
      .replace(/[^A-Za-z0-9 _-]+/g, '')
      .replace(/\s+/g, '_')
      .substring(0, 80);
    return queryId + '_' + safe + '.sql';
  }

  function writeSqlFile(queryId, queryName, sql) {
    try {
      var f = sqlFolder();
      if (!f) return null;
      var file = f.createFile(sqlFileName(queryId, queryName), String(sql || ''), MimeType.PLAIN_TEXT);
      return { id: file.getId(), url: file.getUrl(), name: file.getName() };
    } catch (e) {
      Utils.logError(e, 'writeSqlFile');
      return null;
    }
  }

  function updateSqlFile(fileId, sql) {
    try {
      DriveApp.getFileById(fileId).setContent(String(sql || ''));
      return true;
    } catch (e) {
      Utils.logError(e, 'updateSqlFile');
      return false;
    }
  }

  function trashFile(fileId) {
    try {
      DriveApp.getFileById(fileId).setTrashed(true);
      return true;
    } catch (e) {
      Utils.logError(e, 'trashFile');
      return false;
    }
  }

  /* ---------------------------------------------------------------- *
   * Attachments
   * ---------------------------------------------------------------- */

  function extensionOf(name) {
    var m = String(name || '').toLowerCase().match(/\.([a-z0-9]+)$/);
    return m ? m[1] : '';
  }

  function attachmentsFor(queryId) {
    return SheetDB.filterBy(SHEETS.ATTACHMENTS, 'QueryID', queryId)
      .filter(function (a) { return !Utils.bool(a.IsDeleted); })
      .map(function (a) {
        return {
          attachmentId: a.AttachmentID,
          queryId: a.QueryID,
          fileName: a.FileName,
          fileUrl: a.FileURL,
          mimeType: a.MimeType,
          size: Utils.num(a.Size, 0),
          uploadedBy: a.UploadedBy,
          uploadedAt: a.UploadedAt
        };
      });
  }

  /**
   * Upload a supporting file.
   * payload = { queryId, fileName, mimeType, base64 }
   */
  function upload(ctx, payload) {
    if (!Settings.getBool('ALLOW_DRIVE_FILES')) {
      return Utils.err('File attachments are disabled by your administrator.', 'DISABLED');
    }
    if (!Auth.can(ctx, 'UPLOAD_ATTACHMENT')) {
      Log.denied(ctx, 'UPLOAD_ATTACHMENT');
      return Utils.err('You do not have permission to attach files.', 'FORBIDDEN');
    }

    var queryId = Utils.text(payload.queryId, 40);
    var query = Queries.findRow(queryId);
    if (!query) return Utils.err('That query could not be found.', 'NOT_FOUND');
    if (!Auth.canEditQuery(ctx, query)) {
      return Utils.err('You can only attach files to queries you can edit.', 'FORBIDDEN');
    }

    var fileName = Utils.text(payload.fileName, 150).replace(/[\/\\]/g, '_');
    if (!fileName) return Utils.err('The file has no name.', 'VALIDATION');

    var ext = extensionOf(fileName);
    if (APP.ALLOWED_ATTACHMENT_EXT.indexOf(ext) === -1) {
      return Utils.err('Files of type ".' + ext + '" are not allowed. Permitted: ' + APP.ALLOWED_ATTACHMENT_EXT.join(', ') + '.', 'BAD_TYPE');
    }

    var b64 = String(payload.base64 || '');
    // base64 expands by ~4/3; check the decoded size before touching Drive.
    if (b64.length * 0.75 > APP.MAX_ATTACHMENT_BYTES) {
      return Utils.err('That file is larger than the ' + Math.round(APP.MAX_ATTACHMENT_BYTES / 1048576) + ' MB limit.', 'TOO_LARGE');
    }

    try {
      var f = attachmentFolder();
      if (!f) return Utils.err('The attachments folder is not configured. Run setupSystem().', 'NO_FOLDER');

      var bytes = Utilities.base64Decode(b64);
      var blob = Utilities.newBlob(bytes, Utils.text(payload.mimeType, 100) || MimeType.PLAIN_TEXT, queryId + '_' + fileName);
      var file = f.createFile(blob);

      var rec = {
        AttachmentID: 'ATT-' + Utils.token(20),
        QueryID: queryId,
        FileName: fileName,
        FileID: file.getId(),
        FileURL: file.getUrl(),
        MimeType: file.getMimeType(),
        Size: file.getSize(),
        UploadedBy: ctx.name,
        UploadedAt: Utils.iso(Utils.now()),
        IsDeleted: 'FALSE'
      };
      SheetDB.insert(SHEETS.ATTACHMENTS, rec);

      Log.write(ctx, 'UPLOAD_ATTACHMENT', 'Drive', queryId, 'Attached ' + fileName);
      return Utils.ok(attachmentsFor(queryId), fileName + ' attached.');
    } catch (e) {
      Utils.logError(e, 'DriveService.upload');
      return Utils.err('The file could not be uploaded. Please try again.', 'UPLOAD_FAILED');
    }
  }

  function removeAttachment(ctx, attachmentId) {
    var row = SheetDB.findBy(SHEETS.ATTACHMENTS, 'AttachmentID', Utils.text(attachmentId, 40));
    if (!row) return Utils.err('That attachment could not be found.', 'NOT_FOUND');

    var query = Queries.findRow(row.QueryID);
    if (!query || !Auth.canEditQuery(ctx, query)) {
      return Utils.err('You do not have permission to remove this attachment.', 'FORBIDDEN');
    }

    trashFile(row.FileID);
    row.IsDeleted = 'TRUE';
    SheetDB.update(SHEETS.ATTACHMENTS, row);

    Log.write(ctx, 'DELETE_ATTACHMENT', 'Drive', row.QueryID, 'Removed ' + row.FileName);
    return Utils.ok(attachmentsFor(row.QueryID), 'Attachment removed.');
  }

  /** Create (or refresh) the .sql mirror for an existing query. */
  function syncSqlFile(ctx, queryId) {
    var row = Queries.findRow(queryId);
    if (!row) return Utils.err('That query could not be found.', 'NOT_FOUND');
    if (!Auth.canEditQuery(ctx, row)) return Utils.err('You do not have permission to edit this query.', 'FORBIDDEN');
    if (!Settings.getBool('ALLOW_DRIVE_FILES')) return Utils.err('Drive files are disabled.', 'DISABLED');

    var body = Queries.sqlFileBody(row);
    if (row.DriveFileID && updateSqlFile(row.DriveFileID, body)) {
      return Utils.ok({ url: row.DriveFileURL }, 'Drive file updated.');
    }
    var file = writeSqlFile(row.QueryID, row.QueryName, body);
    if (!file) return Utils.err('The Drive folder is not available.', 'NO_FOLDER');

    row.DriveFileID = file.id;
    row.DriveFileURL = file.url;
    SheetDB.update(SHEETS.QUERIES, row);
    return Utils.ok({ url: file.url }, 'Drive file created.');
  }

  return {
    sqlFileName: sqlFileName,
    writeSqlFile: writeSqlFile,
    updateSqlFile: updateSqlFile,
    trashFile: trashFile,
    attachmentsFor: attachmentsFor,
    upload: upload,
    removeAttachment: removeAttachment,
    syncSqlFile: syncSqlFile,
    sqlFolder: sqlFolder,
    attachmentFolder: attachmentFolder,
    exportFolder: exportFolder,
    backupFolder: backupFolder
  };
})();


/* ========================================================================== *
 * SECTION 13 — Backup.gs
 * CSV / ZIP export and full backups.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Backup.gs
 * ----------------------------------------------------------------------------
 * Exports and backups.
 *
 *   exportCsv()   — filtered query metadata + SQL as a CSV string
 *   exportSql()   — one .sql file per query, returned as a base64 ZIP
 *   createBackup()— an .xlsx snapshot of the whole database in Drive/Backups
 * ============================================================================
 */

var Backup = (function () {

  /* ---------------------------------------------------------------- *
   * CSV
   * ---------------------------------------------------------------- */

  function csvCell(v) {
    var s = (v === null || v === undefined) ? '' : String(v);
    // Guard against CSV formula injection when the file is opened in Excel.
    if (/^[=+\-@]/.test(s)) s = "'" + s;
    if (/[",\n\r]/.test(s)) s = '"' + s.replace(/"/g, '""') + '"';
    return s;
  }

  function toCsv(headerRow, rows) {
    var out = [headerRow.map(csvCell).join(',')];
    for (var i = 0; i < rows.length; i++) out.push(rows[i].map(csvCell).join(','));
    return out.join('\r\n');
  }

  /** Resolve the set of queries an export should contain. */
  function selectQueries_(ctx, filters) {
    var f = filters || {};
    if (Array.isArray(f.queryIds) && f.queryIds.length) {
      var wanted = {};
      f.queryIds.forEach(function (id) { wanted[String(id)] = true; });
      return SheetDB.readAll(SHEETS.QUERIES).filter(function (r) {
        return wanted[r.QueryID] && !Utils.bool(r.IsDeleted);
      });
    }
    // Reuse the list filters so "export what I am looking at" works.
    var listed = Queries.list(ctx, {
      scope: f.scope || 'all',
      search: f.search,
      categoryId: f.categoryId,
      databaseId: f.databaseId,
      status: f.status,
      tag: f.tag,
      createdByEmail: f.createdByEmail,
      page: 1,
      pageSize: 200
    });
    var ids = {};
    listed.rows.forEach(function (r) { ids[r.queryId] = true; });
    return SheetDB.readAll(SHEETS.QUERIES).filter(function (r) { return ids[r.QueryID]; });
  }

  function exportCsv(ctx, filters) {
    if (!Settings.getBool('ALLOW_EXPORT')) return Utils.err('Export is disabled by your administrator.', 'DISABLED');
    if (!Auth.can(ctx, 'EXPORT_DATA')) {
      Log.denied(ctx, 'EXPORT_DATA');
      return Utils.err('You do not have permission to export data.', 'FORBIDDEN');
    }

    var rows = selectQueries_(ctx, filters);
    var cats = Queries.categoryMap();
    var dbs = Queries.databaseMap();

    var header = ['Query ID', 'Query Name', 'Category', 'Database', 'Environment',
      'Description', 'Tags', 'Status', 'SQL', 'Created By', 'Created On',
      'Updated By', 'Updated On', 'Version', 'Usage Count'];

    var data = rows.map(function (r) {
      var db = dbs[r.DatabaseID] || { name: '', env: '' };
      return [
        r.QueryID, r.QueryName, cats[r.CategoryID] || '', db.name, db.env,
        r.Description, r.Tags, r.Status, r.SQLCode,
        r.CreatedBy, Utils.fmt(r.CreatedAt),
        r.UpdatedBy, Utils.fmt(r.UpdatedAt),
        r.Version, r.UsageCount
      ];
    });

    var csv = toCsv(header, data);
    Log.write(ctx, 'EXPORT_DATA', 'Backup', '', 'Exported ' + rows.length + ' queries as CSV');

    return Utils.ok({
      filename: 'sql_query_notebook_' + Utils.fmtDateOnly(Utils.now()) + '.csv',
      mimeType: 'text/csv',
      content: csv,
      count: rows.length
    }, 'Exported ' + rows.length + ' quer' + (rows.length === 1 ? 'y' : 'ies') + '.');
  }

  /* ---------------------------------------------------------------- *
   * ZIP of .sql files
   * ---------------------------------------------------------------- */
  function exportSqlZip(ctx, filters) {
    if (!Settings.getBool('ALLOW_EXPORT')) return Utils.err('Export is disabled by your administrator.', 'DISABLED');
    if (!Auth.can(ctx, 'EXPORT_DATA')) {
      Log.denied(ctx, 'EXPORT_DATA');
      return Utils.err('You do not have permission to export data.', 'FORBIDDEN');
    }

    var rows = selectQueries_(ctx, filters);
    if (!rows.length) return Utils.err('There is nothing to export.', 'EMPTY');
    if (rows.length > 300) return Utils.err('Narrow the filter — a ZIP can hold at most 300 queries.', 'TOO_MANY');

    try {
      var blobs = rows.map(function (r) {
        return Utilities.newBlob(Queries.sqlFileBody(r), 'text/plain',
          DriveService.sqlFileName(r.QueryID, r.QueryName));
      });
      var name = 'sql_query_notebook_' + Utils.fmtDateOnly(Utils.now()) + '.zip';
      var zip = Utilities.zip(blobs, name);

      // Also drop a copy in Drive/Exports so it is not lost on refresh.
      var driveUrl = '';
      var f = DriveService.exportFolder();
      if (f) { try { driveUrl = f.createFile(zip).getUrl(); } catch (e) { Utils.logError(e, 'exportSqlZip drive'); } }

      Log.write(ctx, 'EXPORT_DATA', 'Backup', '', 'Exported ' + rows.length + ' .sql files as ZIP');

      return Utils.ok({
        filename: name,
        mimeType: 'application/zip',
        base64: Utilities.base64Encode(zip.getBytes()),
        count: rows.length,
        driveUrl: driveUrl
      }, 'Packed ' + rows.length + ' .sql file(s).');
    } catch (e) {
      Utils.logError(e, 'exportSqlZip');
      return Utils.err('The ZIP could not be built. Try exporting fewer queries.', 'ZIP_FAILED');
    }
  }

  /* ---------------------------------------------------------------- *
   * Full backup
   * ---------------------------------------------------------------- */
  function createBackup(ctx) {
    if (!Auth.can(ctx, 'CREATE_BACKUP')) {
      Log.denied(ctx, 'CREATE_BACKUP');
      return Utils.err('You do not have permission to create backups.', 'FORBIDDEN');
    }

    try {
      var book = SheetDB.ss();
      var stamp = Utils.fmtDateOnly(Utils.now());
      var name = 'SQL_Query_Notebook_Backup_' + stamp;

      var folder = DriveService.backupFolder();
      if (!folder) return Utils.err('The Backups folder is not configured. Run setupSystem().', 'NO_FOLDER');

      // 1. A native Sheets copy (fast, fully restorable).
      var copy = DriveApp.getFileById(book.getId()).makeCopy(name, folder);

      // 2. An .xlsx snapshot for offline archiving.
      var xlsxUrl = '';
      try {
        var url = 'https://docs.google.com/spreadsheets/d/' + book.getId() + '/export?format=xlsx';
        var response = UrlFetchApp.fetch(url, {
          headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() },
          muteHttpExceptions: true
        });
        if (response.getResponseCode() === 200) {
          var blob = response.getBlob().setName(name + '.xlsx');
          xlsxUrl = folder.createFile(blob).getUrl();
        }
      } catch (e) {
        Utils.logError(e, 'createBackup xlsx');
      }

      var counts = {};
      for (var key in SHEETS) counts[SHEETS[key]] = SheetDB.readAll(SHEETS[key]).length;

      Log.write(ctx, 'CREATE_BACKUP', 'Backup', '', 'Backup created: ' + name);

      return Utils.ok({
        name: name,
        sheetCopyUrl: copy.getUrl(),
        xlsxUrl: xlsxUrl,
        folderUrl: folder.getUrl(),
        createdAt: Utils.iso(Utils.now()),
        rowCounts: counts
      }, 'Backup created in Drive.');
    } catch (e) {
      Utils.logError(e, 'createBackup');
      return Utils.err('The backup could not be created. Check the script has Drive access.', 'BACKUP_FAILED');
    }
  }

  /** List existing backups so the admin panel can show them. */
  function listBackups(ctx) {
    if (!Auth.can(ctx, 'CREATE_BACKUP')) {
      return Utils.err('You do not have permission to view backups.', 'FORBIDDEN');
    }
    try {
      var folder = DriveService.backupFolder();
      if (!folder) return Utils.ok({ folderUrl: '', files: [] });

      var it = folder.getFiles();
      var files = [];
      while (it.hasNext() && files.length < 60) {
        var f = it.next();
        files.push({
          name: f.getName(),
          url: f.getUrl(),
          size: f.getSize(),
          createdAt: Utils.iso(f.getDateCreated())
        });
      }
      files.sort(function (a, b) { return a.createdAt < b.createdAt ? 1 : -1; });
      return Utils.ok({ folderUrl: folder.getUrl(), files: files });
    } catch (e) {
      Utils.logError(e, 'listBackups');
      return Utils.err('The backup list could not be loaded.', 'LIST_FAILED');
    }
  }

  /**
   * Scheduled backup entry point — attach a weekly time driven trigger to
   * this function from the Apps Script editor if you want automatic backups.
   */
  function scheduledBackup() {
    var ctx = {
      ok: true, userId: 'SYSTEM', name: 'Scheduled Backup', email: '',
      _permMap: { CREATE_BACKUP: true }, permissions: ['CREATE_BACKUP'], sessionId: ''
    };
    return createBackup(ctx);
  }

  return {
    exportCsv: exportCsv,
    exportSqlZip: exportSqlZip,
    createBackup: createBackup,
    listBackups: listBackups,
    scheduledBackup: scheduledBackup,
    toCsv: toCsv
  };
})();

/** Wrapper so a time driven trigger can call the scheduled backup directly. */
function runScheduledBackup() {
  return Backup.scheduledBackup();
}


/* ========================================================================== *
 * SECTION 14 — Notifications.gs
 * Gmail notifications.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Notifications.gs
 * ----------------------------------------------------------------------------
 * Email notifications through MailApp.
 *
 * DESIGN RULES
 *   - notify on meaningful events only (shared, updated, deleted, permission
 *     changed, account created). Never on a view or a copy.
 *   - never let a mail failure break the request that triggered it
 *   - respect the ALLOW_EMAIL_NOTIFICATIONS setting
 *   - respect the daily MailApp quota; degrade silently when exhausted
 *   - every value interpolated into the HTML body is escaped
 * ============================================================================
 */

var Notifications = (function () {

  function enabled() {
    try { return Settings.getBool('ALLOW_EMAIL_NOTIFICATIONS'); }
    catch (e) { return false; }
  }

  function quotaLeft() {
    try { return MailApp.getRemainingDailyQuota(); }
    catch (e) { return 0; }
  }

  function appUrl() {
    try { return ScriptApp.getService().getUrl() || ''; }
    catch (e) { return ''; }
  }

  var e = function (s) { return Utils.escapeHtml(s); };

  /** Shared HTML shell so every notification looks the same. */
  function shell(title, introHtml, rowsHtml, ctaLabel, ctaHref) {
    var url = ctaHref || appUrl();
    var cta = (ctaLabel && url)
      ? '<tr><td style="padding:24px 28px 4px">' +
        '<a href="' + e(url) + '" style="background:#5B3DF5;color:#fff;text-decoration:none;' +
        'padding:11px 20px;border-radius:8px;font-weight:600;display:inline-block">' + e(ctaLabel) + '</a>' +
        '</td></tr>'
      : '';

    return [
      '<div style="font-family:Inter,Arial,Helvetica,sans-serif;background:#F4F5FB;padding:28px">',
      '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" ',
      'style="max-width:620px;margin:0 auto;background:#fff;border-radius:14px;overflow:hidden;',
      'border:1px solid #E4E6F2">',
      '<tr><td style="background:#1E1B4B;padding:20px 28px">',
      '<div style="color:#fff;font-size:17px;font-weight:700;letter-spacing:-.2px">' + e(APP.NAME) + '</div>',
      '<div style="color:#A5B4FC;font-size:12px;margin-top:2px">' + e(APP.SUBTITLE) + '</div>',
      '</td></tr>',
      '<tr><td style="padding:26px 28px 6px">',
      '<div style="font-size:18px;font-weight:700;color:#111827;margin-bottom:10px">' + e(title) + '</div>',
      '<div style="font-size:14px;color:#4B5563;line-height:1.6">' + introHtml + '</div>',
      '</td></tr>',
      rowsHtml ? '<tr><td style="padding:14px 28px 0">' +
        '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" ' +
        'style="border:1px solid #EEF0F8;border-radius:10px;font-size:13px;color:#374151">' +
        rowsHtml + '</table></td></tr>' : '',
      cta,
      '<tr><td style="padding:22px 28px 26px">',
      '<div style="font-size:11px;color:#9CA3AF;border-top:1px solid #EEF0F8;padding-top:14px">',
      'Automated message from ' + e(APP.NAME) + '. You are receiving it because you have an account in this workspace.',
      '</div></td></tr>',
      '</table></div>'
    ].join('');
  }

  function row(label, value) {
    return '<tr><td style="padding:9px 14px;color:#6B7280;width:130px;border-bottom:1px solid #F3F4F8">' +
      e(label) + '</td><td style="padding:9px 14px;font-weight:600;color:#111827;border-bottom:1px solid #F3F4F8">' +
      e(value) + '</td></tr>';
  }

  /** Fire and forget. Never throws. */
  function send(to, subject, html) {
    if (!enabled()) return false;
    var recipients = (Array.isArray(to) ? to : [to])
      .map(Utils.normEmail)
      .filter(function (m) { return Utils.isEmail(m); });
    if (!recipients.length) return false;
    if (quotaLeft() < recipients.length) {
      Utils.logError('MailApp daily quota exhausted', 'Notifications.send');
      return false;
    }
    try {
      MailApp.sendEmail({
        to: recipients.join(','),
        subject: Utils.text(subject, 200),
        htmlBody: html,
        name: APP.NAME
      });
      return true;
    } catch (err) {
      Utils.logError(err, 'Notifications.send');
      return false;
    }
  }

  /* ---------------------------------------------------------------- *
   * Events
   * ---------------------------------------------------------------- */

  function queryShared(ctx, query, recipients, permission) {
    var href = appUrl() ? appUrl() + '?q=' + encodeURIComponent(query.QueryID) : '';
    var html = shell(
      'A query was shared with you',
      e(ctx.name) + ' gave you <strong>' + e(permission) + '</strong> access to a saved SQL query.',
      row('Query ID', query.QueryID) +
      row('Name', query.QueryName) +
      row('Shared by', ctx.name + ' (' + ctx.email + ')') +
      row('Access', permission),
      'Open the query', href
    );
    send(recipients, '[' + APP.NAME + '] ' + query.QueryName + ' was shared with you', html);
  }

  /** Notify the owner and anyone the query is shared with — but not the editor. */
  function queryUpdated(ctx, query, summary) {
    var audience = {};
    var owner = Utils.normEmail(query.CreatedByEmail);
    if (owner && owner !== ctx.email) audience[owner] = true;
    try {
      Sharing.activeShares().forEach(function (s) {
        if (s.QueryID !== query.QueryID) return;
        var m = Utils.normEmail(s.SharedTo);
        if (m && m !== ctx.email) audience[m] = true;
      });
    } catch (err) { Utils.logError(err, 'queryUpdated audience'); }

    var list = Object.keys(audience);
    if (!list.length) return;

    var href = appUrl() ? appUrl() + '?q=' + encodeURIComponent(query.QueryID) : '';
    var html = shell(
      'A query you follow was updated',
      e(ctx.name) + ' saved a new version of a query you own or have access to.',
      row('Query ID', query.QueryID) +
      row('Name', query.QueryName) +
      row('New version', query.Version) +
      row('Updated by', ctx.name) +
      row('Change', summary || 'Updated'),
      'View the change', href
    );
    send(list, '[' + APP.NAME + '] ' + query.QueryName + ' updated to v' + query.Version, html);
  }

  function queryDeleted(ctx, query) {
    var owner = Utils.normEmail(query.CreatedByEmail);
    if (!owner || owner === ctx.email) return;
    var html = shell(
      'A query you own was moved to Trash',
      e(ctx.name) + ' moved one of your queries to Trash. It can still be restored by an administrator.',
      row('Query ID', query.QueryID) +
      row('Name', query.QueryName) +
      row('Moved by', ctx.name) +
      row('When', Utils.fmt(Utils.now())),
      'Open ' + APP.NAME, ''
    );
    send(owner, '[' + APP.NAME + '] ' + query.QueryName + ' moved to Trash', html);
  }

  function permissionChanged(ctx, user) {
    var roleNames = Users.roleNameMap();
    var html = shell(
      'Your access level changed',
      'An administrator updated your permissions in ' + e(APP.NAME) + '.',
      row('Account', user.Email) +
      row('New role', roleNames[user.RoleID] || user.RoleID) +
      row('Changed by', ctx.name),
      'Open ' + APP.NAME, ''
    );
    send(user.Email, '[' + APP.NAME + '] Your access level changed', html);
  }

  function userInvited(ctx, user, tempPassword) {
    var pwBlock = tempPassword
      ? row('Temporary password', tempPassword) +
        '<tr><td colspan="2" style="padding:9px 14px;color:#B45309;font-size:12px">' +
        'Change this password the first time you sign in.</td></tr>'
      : '';
    var html = shell(
      'Your account is ready',
      e(ctx.name) + ' created an account for you in ' + e(APP.NAME) + '. ' +
      (tempPassword
        ? 'Sign in with the temporary password below.'
        : 'Sign in with your Google account — no password needed.'),
      row('Account', user.Email) +
      row('Role', Users.roleNameMap()[user.RoleID] || user.RoleID) +
      pwBlock,
      'Open ' + APP.NAME, ''
    );
    send(user.Email, '[' + APP.NAME + '] Your account is ready', html);
  }

  function passwordReset(ctx, user, tempPassword) {
    var html = shell(
      'Your password was reset',
      'An administrator generated a new temporary password for your account. ' +
      'Please change it immediately after signing in.',
      row('Account', user.Email) +
      row('Temporary password', tempPassword) +
      row('Reset by', ctx.name),
      'Sign in', ''
    );
    send(user.Email, '[' + APP.NAME + '] Your password was reset', html);
  }

  /** Manual test hook — run from the editor to verify mail delivery. */
  function sendTestEmail() {
    var to = Session.getEffectiveUser().getEmail();
    var okSent = send(to, '[' + APP.NAME + '] Test notification',
      shell('Notifications are working',
        'If you can read this, MailApp is configured correctly.',
        row('Sent to', to) + row('Quota remaining', String(quotaLeft())),
        'Open ' + APP.NAME, ''));
    console.log(okSent ? 'Test email sent to ' + to : 'Email not sent — notifications may be disabled or quota exhausted.');
    return okSent;
  }

  return {
    send: send,
    queryShared: queryShared,
    queryUpdated: queryUpdated,
    queryDeleted: queryDeleted,
    permissionChanged: permissionChanged,
    userInvited: userInvited,
    passwordReset: passwordReset,
    sendTestEmail: sendTestEmail,
    appUrl: appUrl
  };
})();

/** Editor entry point for the notification smoke test. */
function sendTestNotification() {
  return Notifications.sendTestEmail();
}


/* ========================================================================== *
 * SECTION 15 — Setup.gs
 * setupSystem(), seedDemoData() and maintenance helpers.
 * ========================================================================== */
/**
 * ============================================================================
 * SQL Query Notebook — Setup.gs
 * ----------------------------------------------------------------------------
 * One-click provisioning. RUN setupSystem() FROM THE APPS SCRIPT EDITOR.
 *
 * setupSystem() is IDEMPOTENT — it is safe to run again at any time:
 *   - existing sheets keep their data, only missing sheets/columns are added
 *   - seed rows are only inserted when a table is empty
 *   - Drive folders are reused when they already exist
 *   - the first Admin is only created once
 * ============================================================================
 */

/**
 * Provision (or repair) the entire system.
 * @return {object} a human readable report
 */
function setupSystem() {
  var report = { createdSheets: [], repairedSheets: [], seeded: [], folders: {}, notes: [] };

  // ---------------------------------------------------------------- 1. Book
  var book = resolveSpreadsheet_(report);
  setProp(PROP.SPREADSHEET_ID, book.getId());

  // -------------------------------------------------------- 2. Sheets/headers
  for (var key in SHEETS) {
    var name = SHEETS[key];
    var sh = book.getSheetByName(name);
    if (!sh) {
      sh = book.insertSheet(name);
      report.createdSheets.push(name);
    }
    if (ensureHeaders_(sh, HEADERS[name])) report.repairedSheets.push(name);
    formatSheet_(sh, HEADERS[name].length);
  }

  // Remove the default empty "Sheet1" if it is untouched.
  var def = book.getSheetByName('Sheet1');
  if (def && book.getSheets().length > 1 && def.getLastRow() === 0) {
    book.deleteSheet(def);
  }

  // Clear caches so the new structure is picked up immediately.
  __MEMO__ = {};
  Cache.remove('settings');
  Cache.remove('rolePerms');

  // ------------------------------------------------------------ 3. Seed data
  if (seedRoles_())       report.seeded.push('Roles');
  if (seedPermissions_()) report.seeded.push('Permissions');
  if (seedCategories_())  report.seeded.push('Categories');
  if (seedDatabases_())   report.seeded.push('Databases');
  if (seedSettings_())    report.seeded.push('Settings');

  // ------------------------------------------------------------ 4. Drive
  report.folders = ensureDriveFolders_();

  // ------------------------------------------------------------ 5. Admin
  var admin = seedAdmin_();
  if (admin.created) {
    report.seeded.push('Admin user (' + admin.email + ')');
  } else {
    report.notes.push('Admin already present: ' + admin.email);
  }

  // -------------------------------------------------- 6. Repair ID sequences
  SheetDB.seedSequence('QUERY',    SHEETS.QUERIES,    'QueryID',    'SQL-');
  SheetDB.seedSequence('CATEGORY', SHEETS.CATEGORIES, 'CategoryID', 'CAT-');
  SheetDB.seedSequence('DATABASE', SHEETS.DATABASES,  'DatabaseID', 'DB-');
  SheetDB.seedSequence('USER',     SHEETS.USERS,      'UserID',     'USR-');

  // ------------------------------------------------------------ 7. Properties
  setProps({
    APP_NAME: APP.NAME,
    SESSION_TIMEOUT: String(APP.DEFAULT_SESSION_TIMEOUT_MIN),
    SETUP_COMPLETED_AT: Utils.iso(Utils.now())
  });

  Log.write({ userId: 'SYSTEM', name: 'System', email: '' }, 'SETUP', 'Setup', '',
    'setupSystem() completed. Version ' + APP.VERSION);

  var summary = [
    '=========================================',
    ' ' + APP.NAME + ' — setup complete',
    '=========================================',
    'Spreadsheet : ' + book.getName(),
    'Sheet ID    : ' + book.getId(),
    'URL         : ' + book.getUrl(),
    '',
    'Sheets created  : ' + (report.createdSheets.join(', ') || 'none (all existed)'),
    'Sheets repaired : ' + (report.repairedSheets.join(', ') || 'none'),
    'Seeded          : ' + (report.seeded.join(', ') || 'nothing (already seeded)'),
    'Drive root      : ' + report.folders.rootUrl,
    '',
    (report.notes.join('\n') || ''),
    '',
    'NEXT STEPS',
    '  1. (optional) run seedDemoData() to load 10 example queries',
    '  2. Deploy > New deployment > Web app',
    '  3. Execute as: Me   |   Who has access: your organisation',
    '  4. Open the web app URL',
    '========================================='
  ].join('\n');

  console.log(summary);
  report.summary = summary;
  return report;
}

/** Resolve or create the backing spreadsheet. */
function resolveSpreadsheet_(report) {
  var id = getProp(PROP.SPREADSHEET_ID);
  if (id) {
    try { return SpreadsheetApp.openById(id); }
    catch (e) { report.notes.push('Stored SPREADSHEET_ID was unusable, creating a new book.'); }
  }
  var active = null;
  try { active = SpreadsheetApp.getActiveSpreadsheet(); } catch (e) {}
  if (active) {
    report.notes.push('Bound to the active spreadsheet.');
    return active;
  }
  var created = SpreadsheetApp.create(APP.SPREADSHEET_NAME);
  report.notes.push('Created a new spreadsheet: ' + APP.SPREADSHEET_NAME);
  return created;
}

/**
 * Make sure row 1 carries exactly the expected headers.
 * Missing columns are APPENDED (never re-ordered) so existing data is safe.
 * @return {boolean} true when the sheet was modified
 */
function ensureHeaders_(sheet, expected) {
  var lastCol = sheet.getLastColumn();
  var current = lastCol > 0 ? sheet.getRange(1, 1, 1, lastCol).getValues()[0] : [];
  var changed = false;

  // Empty sheet -> write all headers.
  var anyHeader = current.some(function (v) { return String(v || '') !== ''; });
  if (!anyHeader) {
    sheet.getRange(1, 1, 1, expected.length).setValues([expected]);
    return true;
  }

  // Append any header that is missing.
  var have = {};
  for (var i = 0; i < current.length; i++) have[String(current[i])] = i + 1;

  var toAppend = [];
  for (var j = 0; j < expected.length; j++) {
    if (!have[expected[j]]) toAppend.push(expected[j]);
  }
  if (toAppend.length) {
    sheet.getRange(1, lastCol + 1, 1, toAppend.length).setValues([toAppend]);
    changed = true;
  }
  return changed;
}

/** Cosmetic: frozen header, bold, sensible widths. */
function formatSheet_(sheet, cols) {
  try {
    sheet.setFrozenRows(1);
    var header = sheet.getRange(1, 1, 1, cols);
    header.setFontWeight('bold')
      .setBackground('#EEF0FF')
      .setFontColor('#1E1B4B')
      .setVerticalAlignment('middle');
    sheet.setRowHeight(1, 30);
  } catch (e) {
    Utils.logError(e, 'formatSheet_');
  }
}

/* ------------------------------------------------------------------ *
 * Seeders — each returns true when it actually inserted something.
 * ------------------------------------------------------------------ */

function seedRoles_() {
  if (SheetDB.readAll(SHEETS.ROLES).length) return false;
  var stamp = Utils.iso(Utils.now());
  SheetDB.insertMany(SHEETS.ROLES, DEFAULT_ROLES.map(function (r) {
    return {
      RoleID: r.id, RoleName: r.name, Description: r.desc,
      IsSystem: r.system ? 'TRUE' : 'FALSE', CreatedAt: stamp
    };
  }));
  return true;
}

function seedPermissions_() {
  if (SheetDB.readAll(SHEETS.PERMISSIONS).length) return false;
  var rows = [];
  for (var roleId in DEFAULT_ROLE_PERMISSIONS) {
    var allowed = {};
    DEFAULT_ROLE_PERMISSIONS[roleId].forEach(function (p) { allowed[p] = true; });
    for (var i = 0; i < PERMISSIONS.length; i++) {
      var perm = PERMISSIONS[i];
      rows.push({
        PermissionID: 'PRM-' + roleId.replace('ROLE-', '') + '-' + perm,
        RoleID: roleId,
        Permission: perm,
        Allowed: allowed[perm] ? 'TRUE' : 'FALSE'
      });
    }
  }
  SheetDB.insertMany(SHEETS.PERMISSIONS, rows);
  return true;
}

function seedCategories_() {
  if (SheetDB.readAll(SHEETS.CATEGORIES).length) return false;
  var stamp = Utils.iso(Utils.now());
  var rows = DEFAULT_CATEGORIES.map(function (c, i) {
    return {
      CategoryID: 'CAT-' + Utils.pad(i + 1, 3),
      CategoryName: c.name,
      Description: c.desc,
      Status: 'Active',
      CreatedBy: 'System',
      CreatedAt: stamp,
      UpdatedAt: stamp
    };
  });
  SheetDB.insertMany(SHEETS.CATEGORIES, rows);
  PropertiesService.getScriptProperties().setProperty(PROP.SEQ_PREFIX + 'CATEGORY', String(rows.length));
  return true;
}

function seedDatabases_() {
  if (SheetDB.readAll(SHEETS.DATABASES).length) return false;
  var stamp = Utils.iso(Utils.now());
  var rows = DEFAULT_DATABASES.map(function (d, i) {
    return {
      DatabaseID: 'DB-' + Utils.pad(i + 1, 3),
      DatabaseName: d.name,
      Description: d.desc,
      Environment: d.env,
      Status: 'Active',
      CreatedBy: 'System',
      CreatedAt: stamp
    };
  });
  SheetDB.insertMany(SHEETS.DATABASES, rows);
  PropertiesService.getScriptProperties().setProperty(PROP.SEQ_PREFIX + 'DATABASE', String(rows.length));
  return true;
}

function seedSettings_() {
  var existing = SheetDB.readAll(SHEETS.SETTINGS);
  if (existing.length) {
    // Add any newly introduced setting keys without touching existing values.
    var have = {};
    existing.forEach(function (r) { have[r.Key] = true; });
    var missing = [];
    var stamp = Utils.iso(Utils.now());
    for (var k in DEFAULT_SETTINGS) {
      if (!have[k]) missing.push({ Key: k, Value: DEFAULT_SETTINGS[k], UpdatedAt: stamp, UpdatedBy: 'System' });
    }
    if (missing.length) { SheetDB.insertMany(SHEETS.SETTINGS, missing); return true; }
    return false;
  }
  var stamp2 = Utils.iso(Utils.now());
  var rows = [];
  for (var key in DEFAULT_SETTINGS) {
    rows.push({ Key: key, Value: DEFAULT_SETTINGS[key], UpdatedAt: stamp2, UpdatedBy: 'System' });
  }
  SheetDB.insertMany(SHEETS.SETTINGS, rows);
  return true;
}

/** The person running setupSystem() becomes the first Admin. */
function seedAdmin_() {
  var email = Utils.normEmail(Session.getEffectiveUser().getEmail());
  if (!email) {
    // Extremely rare; fall back so setup still completes.
    email = 'admin@example.com';
  }
  var existing = Auth.userByEmail(email);
  if (existing) {
    if (existing.RoleID !== 'ROLE-ADMIN') {
      existing.RoleID = 'ROLE-ADMIN';
      existing.Status = 'Active';
      SheetDB.update(SHEETS.USERS, existing);
    }
    return { created: false, email: email };
  }

  var anyAdmin = SheetDB.readAll(SHEETS.USERS).some(function (u) { return u.RoleID === 'ROLE-ADMIN'; });
  var stamp = Utils.iso(Utils.now());
  var name = email.split('@')[0].replace(/[._-]+/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); });

  SheetDB.insert(SHEETS.USERS, {
    UserID: SheetDB.nextSequence('USER', 'USR-', 4),
    Name: name,
    Email: email,
    RoleID: 'ROLE-ADMIN',
    Department: 'Administration',
    Status: 'Active',
    CreatedAt: stamp,
    LastLogin: '',
    LastLogout: '',
    ActiveSessionID: '',
    PasswordHash: '',
    PasswordSalt: '',
    MustChangePassword: 'FALSE',
    FailedAttempts: 0,
    LockedUntil: ''
  });
  return { created: true, email: email, wasFirstAdmin: !anyAdmin };
}

/** Create the Drive folder tree if it is not already there. */
function ensureDriveFolders_() {
  var rootId = getProp(PROP.DRIVE_ROOT_FOLDER_ID);
  var root = null;

  if (rootId) {
    try { root = DriveApp.getFolderById(rootId); } catch (e) { root = null; }
  }
  if (!root) {
    var it = DriveApp.getFoldersByName(APP.ROOT_FOLDER_NAME);
    root = it.hasNext() ? it.next() : DriveApp.createFolder(APP.ROOT_FOLDER_NAME);
  }

  var ids = { DRIVE_ROOT_FOLDER_ID: root.getId() };
  var mapping = {
    'SQL Files':   PROP.SQL_FOLDER_ID,
    'Attachments': PROP.ATTACHMENT_FOLDER_ID,
    'Exports':     PROP.EXPORT_FOLDER_ID,
    'Backups':     PROP.BACKUP_FOLDER_ID
  };

  APP.SUBFOLDERS.forEach(function (name) {
    var sub = null;
    var subIt = root.getFoldersByName(name);
    sub = subIt.hasNext() ? subIt.next() : root.createFolder(name);
    ids[mapping[name]] = sub.getId();
  });

  setProps(ids);
  return {
    rootId: root.getId(),
    rootUrl: root.getUrl(),
    sqlFolderId: ids[PROP.SQL_FOLDER_ID],
    attachmentFolderId: ids[PROP.ATTACHMENT_FOLDER_ID],
    exportFolderId: ids[PROP.EXPORT_FOLDER_ID],
    backupFolderId: ids[PROP.BACKUP_FOLDER_ID]
  };
}


/* ==================================================================== *
 * seedDemoData() — 10 realistic demo queries.
 *
 * The SQL below is ILLUSTRATIVE ONLY. It assumes a courier/logistics
 * warehouse schema that almost certainly does not match yours. Every
 * demo query is tagged "demo" so you can find and delete them later.
 * ==================================================================== */
function seedDemoData() {
  var existing = SheetDB.readAll(SHEETS.QUERIES);
  if (existing.length) {
    console.log('Queries sheet already has ' + existing.length + ' rows — demo data skipped.');
    return { skipped: true, existing: existing.length };
  }

  var email = Utils.normEmail(Session.getEffectiveUser().getEmail()) || 'admin@example.com';
  var user = Auth.userByEmail(email);
  var name = user ? user.Name : 'System';

  var cats = {};
  SheetDB.readAll(SHEETS.CATEGORIES).forEach(function (c) { cats[c.CategoryName] = c.CategoryID; });
  var dbs = SheetDB.readAll(SHEETS.DATABASES);
  var defaultDb = dbs.length ? dbs[0].DatabaseID : 'DB-001';

  var demos = demoQueryDefinitions_();
  var stamp = Utils.iso(Utils.now());
  var rows = [], versions = [];

  for (var i = 0; i < demos.length; i++) {
    var d = demos[i];
    var id = SheetDB.nextSequence('QUERY', 'SQL-', 6);
    rows.push({
      QueryID: id,
      QueryName: d.name,
      Description: d.description,
      CategoryID: cats[d.category] || cats['Other'] || 'CAT-006',
      DatabaseID: defaultDb,
      SQLCode: d.sql,
      Tags: d.tags,
      Status: d.status || 'Active',
      CreatedBy: name,
      CreatedByEmail: email,
      CreatedAt: stamp,
      UpdatedBy: name,
      UpdatedByEmail: email,
      UpdatedAt: stamp,
      IsFavorite: '',
      IsDeleted: 'FALSE',
      DeletedBy: '',
      DeletedAt: '',
      DriveFileID: '',
      DriveFileURL: '',
      Version: '1.0',
      UsageCount: 0,
      LastUsedAt: ''
    });
    versions.push({
      VersionID: 'VER-' + Utils.token(20),
      QueryID: id,
      VersionNumber: '1.0',
      SQLCode: d.sql,
      Description: d.description,
      ChangedBy: name,
      ChangedByEmail: email,
      ChangedAt: stamp,
      ChangeSummary: 'Initial version (demo data)'
    });
  }

  SheetDB.insertMany(SHEETS.QUERIES, rows);
  SheetDB.insertMany(SHEETS.VERSIONS, versions);

  console.log('Inserted ' + rows.length + ' demo queries (' + rows[0].QueryID + ' … ' + rows[rows.length - 1].QueryID + ').');
  return { inserted: rows.length, first: rows[0].QueryID, last: rows[rows.length - 1].QueryID };
}

