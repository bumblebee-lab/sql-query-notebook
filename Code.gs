/* ==================================================================== *
 * Settings
 * ==================================================================== */

function getSettings(payload) {
  return guard_('MANAGE_SETTINGS', payload, function (ctx) {
    var all = Settings.all();
    return Utils.ok({
      values: all,
      sessionTimeoutMin: Auth.timeoutMinutes(),
      appVersion: APP.VERSION,
      spreadsheetUrl: SheetDB.ss().getUrl(),
      driveRootUrl: (function () {
        try { return DriveApp.getFolderById(getProp(PROP.DRIVE_ROOT_FOLDER_ID)).getUrl(); }
        catch (e) { return ''; }
      })(),
      counts: (function () {
        var c = {};
        for (var k in SHEETS) c[SHEETS[k]] = SheetDB.readAll(SHEETS[k]).length;
        return c;
      })()
    });
  });
}

function updateSettings(payload) {
  return guard_('MANAGE_SETTINGS', payload, function (ctx, p) {
    var allowed = {};
    for (var k in DEFAULT_SETTINGS) allowed[k] = true;

    var applied = 0;
    var values = p.values || {};
    for (var key in values) {
      if (!allowed[key]) continue;                        // whitelist only
      var value = Utils.text(values[key], 200);

      if (key === 'DEFAULT_PAGE_SIZE') {
        value = String(Utils.clampInt(value, 5, 200, APP.DEFAULT_PAGE_SIZE));
      }
      if (key === 'SESSION_TIMEOUT_MIN') {
        value = String(Utils.clampInt(value, 5, 720, APP.DEFAULT_SESSION_TIMEOUT_MIN));
      }
      if (key === 'DEFAULT_THEME' && ['light', 'dark'].indexOf(value) === -1) value = 'light';
      if (key === 'DEFAULT_NEW_USER_ROLE' && !SheetDB.findBy(SHEETS.ROLES, 'RoleID', value)) continue;

      Settings.set(key, value, ctx.name);
      applied++;
    }
    Log.write(ctx, 'UPDATE_SETTINGS', 'Settings', '', applied + ' setting(s) updated');
    return Utils.ok({ applied: applied, values: Settings.all() }, 'Settings saved.');
  });
}
