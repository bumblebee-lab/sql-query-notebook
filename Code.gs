/** Print the current configuration (no secrets are printed). */
function showConfiguration() {
  var props = PropertiesService.getScriptProperties().getProperties();
  var lines = ['--- ' + APP.NAME + ' v' + APP.VERSION + ' configuration ---'];
  Object.keys(props).sort().forEach(function (k) {
    lines.push(k + ' = ' + props[k]);
  });
  var out = lines.join('\n');
  console.log(out);
  return out;
}

/** Expire sessions that are past their window. Attach to a time trigger. */
function cleanupExpiredSessions() {
  var rows = SheetDB.readAll(SHEETS.SESSIONS);
  var now = Utils.now().getTime();
  var dirty = [];
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].Status !== 'ACTIVE') continue;
    var exp = new Date(rows[i].ExpiresAt).getTime();
    if (isNaN(exp) || exp <= now) { rows[i].Status = 'EXPIRED'; dirty.push(rows[i]); }
  }
  if (dirty.length) SheetDB.updateMany(SHEETS.SESSIONS, dirty);
  console.log('Expired ' + dirty.length + ' session(s).');
  return dirty.length;
}

/** Install the recommended time-driven triggers (idempotent). */
function installTriggers() {
  var wanted = { cleanupExpiredSessions: 'hourly' };
  var existing = ScriptApp.getProjectTriggers();
  var have = {};
  existing.forEach(function (t) { have[t.getHandlerFunction()] = true; });

  var made = [];
  if (!have.cleanupExpiredSessions) {
    ScriptApp.newTrigger('cleanupExpiredSessions').timeBased().everyHours(1).create();
    made.push('cleanupExpiredSessions (hourly)');
  }
  console.log(made.length ? 'Installed: ' + made.join(', ') : 'All triggers already installed.');
  return made;
}

/**
 * DANGEROUS. Removes every row of data but keeps sheets and headers.
 * Requires typing the exact confirmation phrase.
 */
function dangerouslyResetAllData(confirmPhrase) {
  if (confirmPhrase !== 'YES DELETE EVERYTHING') {
    throw new Error('Refused. Call dangerouslyResetAllData("YES DELETE EVERYTHING") to proceed.');
  }
  var book = SheetDB.ss();
  for (var key in SHEETS) {
    var sh = book.getSheetByName(SHEETS[key]);
    if (sh && sh.getLastRow() > 1) sh.deleteRows(2, sh.getLastRow() - 1);
  }
  PropertiesService.getScriptProperties().deleteAllProperties();
  console.log('All data cleared. Run setupSystem() again.');
}


