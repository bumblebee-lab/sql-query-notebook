/**
 * ============================================================================
 * SQL Query Notebook — Code.gs
 * ----------------------------------------------------------------------------
 * Web app entry point and the complete server API.
 *
 * EVERY exported function follows the same contract:
 *
 *   input   a single `payload` object. It MAY carry `_token` (the application
 *           session id). Nothing else in it is ever trusted as identity.
 *   output  { success: boolean, data: any, message: string, code?: string }
 *
 * Authorisation happens inside guard_(), never in the browser.
 * ============================================================================
 */

/* ==================================================================== *
 * Web app
 * ==================================================================== */

function doGet(e) {
  var page = HtmlService.createTemplateFromFile('Index');
  page.APP_NAME = APP.NAME;
  page.APP_SUBTITLE = APP.SUBTITLE;
  page.APP_VERSION = APP.VERSION;
  page.DEEP_LINK = (e && e.parameter && e.parameter.q) ? String(e.parameter.q).replace(/[^A-Za-z0-9-]/g, '') : '';

  return page.evaluate()
    .setTitle(APP.NAME)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
    .setFaviconUrl('https://ssl.gstatic.com/docs/spreadsheets/favicon3.ico');
}

/** Server side include used by Index.html. */
function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}


/* ==================================================================== *
 * The guard — the single choke point for authentication, authorisation,
 * rate limiting and error handling.
 * ==================================================================== */

function guard_(permission, payload, fn) {
  var ctx = null;
  try {
    ctx = Auth.identify(payload && payload._token);
    if (!ctx.ok) {
      return { success: false, data: null, message: ctx.message, code: ctx.code };
    }

    if (Auth.rateLimitExceeded(ctx.userId)) {
      Log.write(ctx, 'ACCESS_DENIED', 'Security', '', 'Rate limit exceeded');
      return Utils.err('Too many requests. Please slow down for a moment.', 'RATE_LIMIT');
    }

    if (permission && !Auth.can(ctx, permission)) {
      Log.denied(ctx, permission);
      return Utils.err('You do not have permission to perform this action.', 'FORBIDDEN');
    }

    var result = fn(ctx, payload || {});
    // Allow handlers to return raw data; wrap it in the standard envelope.
    if (result && typeof result === 'object' && result.hasOwnProperty('success')) return result;
    return Utils.ok(result);

  } catch (err) {
    Utils.logError(err, 'guard_ ' + (permission || 'PUBLIC'));
    if (ctx && ctx.ok) {
      Log.write(ctx, 'ACCESS_DENIED', 'Security', '', 'Unhandled error: ' + (err && err.message ? err.message : err));
    }
    // Technical detail stays in the Apps Script logs — users get a plain message.
    return Utils.err('Something went wrong. Please try again.', 'SERVER_ERROR');
  }
}


/* ==================================================================== *
 * Session / bootstrap
 * ==================================================================== */

/** Called once when the page loads. Never requires a session. */
function getBootstrap(payload) {
  try {
    var ctx = Auth.identify(payload && payload._token);
    var settings = {};
    try {
      settings = {
        appName: Settings.get('APP_NAME'),
        defaultTheme: Settings.get('DEFAULT_THEME'),
        defaultPageSize: Settings.getInt('DEFAULT_PAGE_SIZE', APP.DEFAULT_PAGE_SIZE),
        allowSharing: Settings.getBool('ALLOW_SHARING'),
        allowDriveFiles: Settings.getBool('ALLOW_DRIVE_FILES'),
        allowExport: Settings.getBool('ALLOW_EXPORT'),
        sessionTimeoutMin: Auth.timeoutMinutes()
      };
    } catch (e) {
      return Utils.err('The application is not set up yet. An administrator must run setupSystem() in the Apps Script editor.', 'NOT_SETUP');
    }

    if (!ctx.ok) {
      return Utils.ok({
        authenticated: false,
        reason: ctx.code,
        message: ctx.message,
        googleEmail: Auth.googleEmail(),
        settings: settings,
        version: APP.VERSION,
        pageSizeOptions: APP.PAGE_SIZE_OPTIONS
      });
    }

    return Utils.ok({
      authenticated: true,
      user: Auth.publicProfile(ctx),
      settings: settings,
      version: APP.VERSION,
      pageSizeOptions: APP.PAGE_SIZE_OPTIONS,
      lookups: {
        categories: Categories.list(ctx, false),
        databases: Databases.list(ctx, false),
        statuses: ['Active', 'Draft', 'Archived', 'Deprecated'],
        environments: Databases.ENVIRONMENTS
      }
    });
  } catch (err) {
    Utils.logError(err, 'getBootstrap');
    return Utils.err('The application could not start. Please contact an administrator.', 'BOOT_FAILED');
  }
}

function getCurrentUser(payload) {
  return guard_(null, payload, function (ctx) {
    return Utils.ok(Auth.publicProfile(ctx));
  });
}

/** APP mode sign in. Not needed when Google identity is available. */
function login(payload) {
  var p = payload || {};
  return Auth.login(p.email, p.password, { userAgent: p.userAgent, ip: '' });
}

function logout(payload) {
  return guard_(null, payload, function (ctx) { return Auth.logout(ctx); });
}

function changePassword(payload) {
  return guard_(null, payload, function (ctx, p) {
    return Auth.changePassword(ctx, p.currentPassword, p.newPassword);
  });
}

/** Slide the session window forward from the "session expiring" dialog. */
function keepAlive(payload) {
